.form-page {
  padding: 8rpx 32rpx 48rpx;
}
.sec-row {
  display: flex;
  justify-content: flex-end;
  padding: 8rpx 0 12rpx;
}
.add-entry {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
  line-height: 1;
  padding: 8rpx 0 8rpx 16rpx;
}
.row-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}
.title {
  font-size: 30rpx;
  font-weight: 600;
}
.grow {
  flex: 1;
  min-width: 0;
}
.sm {
  font-size: 24rpx;
  margin-top: 6rpx;
}
.row-actions {
  flex: none;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.row-item .btn {
  width: auto !important;
  flex: none;
  margin: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
}
.btn-sm {
  min-height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
}
.empty {
  padding: 80rpx 32rpx;
  text-align: center;
  color: var(--color-muted);
}
.sheet {
  background: var(--color-surface);
  box-sizing: border-box;
  padding: 12rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.grab {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--color-line);
  margin: 8rpx auto 16rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
}
.sheet-close {
  font-size: 26rpx;
  color: var(--color-muted);
  padding: 8rpx 0 8rpx 24rpx;
}
.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.label {
  font-size: 22rpx;
  color: var(--color-muted);
  margin: 16rpx 0 8rpx;
}
.pick-clear {
  font-size: 24rpx;
  color: var(--color-muted);
  padding: 8rpx 0 8rpx 16rpx;
}
.field-input.ph {
  color: var(--color-muted);
}
.field-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.field-col {
  flex: 1;
  width: 0;
  min-width: 0;
}
.field-input {
  display: block;
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  margin: 0;
  box-sizing: border-box;
  background: #f4f7f6;
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
  font-size: 28rpx;
}
.add-btn {
  width: 100% !important;
  margin: 24rpx 0 0;
  box-sizing: border-box;
}
