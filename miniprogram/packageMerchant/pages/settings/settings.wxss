.settings-nav {
  position: sticky;
  z-index: 10;
  display: flex;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-line);
}

.settings-tab {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--color-muted);
  box-sizing: border-box;
}

.settings-tab.on {
  color: var(--color-primary);
  font-weight: 700;
}

.settings-tab.on::after {
  content: "";
  position: absolute;
  left: 22%;
  right: 22%;
  bottom: 0;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--color-primary);
}

.settings-page {
  padding-top: 8rpx;
  padding-bottom: calc(var(--tabbar-height) + 140rpx + env(safe-area-inset-bottom));
}

.sec {
  margin-bottom: 36rpx;
}

.sec-head {
  padding: 0 4rpx 16rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 6rpx;
}

.sec-desc {
  font-size: 22rpx;
  color: var(--color-muted);
  line-height: 1.4;
}

.group {
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius);
  overflow: hidden;
}

.cell {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 96rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid var(--color-line);
  box-sizing: border-box;
}

.cell.last {
  border-bottom: none;
}

.cell-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.cell-input {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.pair .cell-input,
.pair .cell-textarea {
  text-align: right;
}

.cell-note {
  align-items: flex-start;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  min-height: 0;
}

.cell-note .cell-label {
  padding-top: 8rpx;
}

.cell-textarea {
  flex: 1;
  min-width: 0;
  min-height: 120rpx;
  max-height: 360rpx;
  padding: 8rpx 0;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--color-text);
  width: auto;
}

.hero-box {
  height: 200rpx;
  background: var(--color-mist);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-bottom: 1rpx solid var(--color-line);
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-empty {
  padding: 24rpx;
  text-align: center;
}

.hero-empty-txt {
  font-size: 26rpx;
  color: var(--color-muted);
}

.hero-actions {
  min-height: 72rpx;
  justify-content: flex-end;
}

.link-danger {
  color: var(--color-warn);
  font-size: 26rpx;
  padding: 12rpx 0;
}

.cell-unit {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 28rpx;
  color: var(--color-muted);
}

.num-input {
  flex: 1;
  width: auto;
  min-height: 88rpx;
  text-align: right;
  background: transparent;
  border: 0;
  border-radius: 0;
}

.cols-cell {
  align-items: center;
  flex-wrap: nowrap;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.cols-cell .cell-label {
  width: auto;
  margin-bottom: 0;
  white-space: nowrap;
}

.cols-cell .cols-row {
  flex: 1;
  width: auto;
  min-width: 0;
  justify-content: flex-end;
}

.cols-cell .cols-opt {
  flex: 0 0 auto;
  padding: 0 28rpx;
}

.cols-row {
  display: flex;
  gap: 12rpx;
  width: 100%;
}

.cols-opt {
  flex: 1;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-muted);
  background: var(--color-background);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-pill);
  box-sizing: border-box;
}

.cols-opt.on {
  color: var(--color-on-primary);
  font-weight: 600;
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.kicker-cell {
  flex-wrap: wrap;
  align-items: center;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.kicker-cell .cols-row {
  flex: 1;
  width: auto;
  min-width: 0;
  justify-content: flex-end;
}

.kicker-cell .cols-opt {
  flex: 0 0 auto;
  padding: 0 28rpx;
}

.kicker-input {
  flex: 0 0 100%;
  width: 100%;
  min-height: 72rpx;
  margin-top: 16rpx;
  padding: 0 20rpx;
  text-align: left;
  background: var(--color-background);
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.slot-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid var(--color-line);
  font-size: 28rpx;
}

.slot-row.last {
  border-bottom: none;
}

.slot-label {
  flex: 1;
  min-width: 0;
}

.link-muted {
  color: var(--color-muted);
  font-size: 24rpx;
  flex-shrink: 0;
  padding: 16rpx 0 16rpx 24rpx;
}

.slot-add {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 20rpx 12rpx 28rpx;
  border-top: 1rpx solid var(--color-line);
}

.slot-add .grow {
  flex: 1;
  min-width: 0;
}

.btn-inline {
  flex-shrink: 0;
  margin: 0;
  padding: 0 24rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: var(--color-mist);
  border-radius: var(--radius-pill);
  border: none;
}

.btn-inline::after {
  border: none;
}

.slot-add-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-primary);
  border-top: 1rpx solid var(--color-line);
}

.group > .slot-add-btn:first-child {
  border-top: none;
}

.phrase-head {
  padding: 28rpx 4rpx 12rpx;
}

.phrase-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.phrase-group {
  margin-top: 0;
}

.phrase-nav {
  display: flex;
  border-bottom: 1rpx solid var(--color-line);
}

.phrase-tab {
  position: relative;
  flex: 1;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--color-muted);
  box-sizing: border-box;
}

.phrase-tab.on {
  color: var(--color-primary);
  font-weight: 700;
}

.phrase-tab.on::after {
  content: "";
  position: absolute;
  left: 28%;
  right: 28%;
  bottom: 0;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--color-primary);
}

.phrase-hint {
  padding: 16rpx 28rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--color-muted);
  border-bottom: 1rpx solid var(--color-line);
}

.phrase-group .slot-add {
  border-top: none;
}

.phrase-group .btn-inline {
  width: auto;
  min-width: 0;
  padding: 0 28rpx;
}

.save-spacer {
  height: 8rpx;
}

.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 16rpx 32rpx;
  background: rgba(240, 253, 250, 0.92);
  border-top: 1rpx solid var(--color-line);
  box-sizing: border-box;
}

.save-btn {
  width: 100%;
  margin: 0;
}
