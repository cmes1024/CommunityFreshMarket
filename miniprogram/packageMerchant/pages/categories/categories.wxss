.hint {
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.5;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--color-mist);
  border-radius: var(--radius);
}

.cat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-surface);
  border: 2rpx solid var(--color-line);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.cat-name {
  font-weight: 700;
  font-size: 30rpx;
}

.cat-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.chip {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-mist);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 0;
}

.chip.off {
  background: #fee2e2;
  color: var(--color-danger);
}

.link-danger {
  color: var(--color-muted);
  font-size: 24rpx;
}

.add-box {
  margin-top: 8rpx;
}

.field-input {
  min-height: 88rpx;
  background: #f4f7f6;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius);
  padding: 0 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.full {
  width: 100%;
  margin-top: 8rpx;
}
