<Header pageName="{{copy.titles.merchantProducts}}" back="{{false}}" toCustomer="{{true}}" />
<view class="page-body products-page">
  <view class="m-toolbar">
    <button class="btn btn-ghost btn-sm" bind:tap="goCats">{{copy.merchant.catManage}}</button>
    <button class="btn btn-cta btn-sm" bind:tap="create">{{copy.merchant.addProduct}}</button>
  </view>

  <view class="m-filters">
    <view class="m-search">
      <input
        class="m-search-input"
        placeholder="{{copy.merchant.searchPlaceholder}}"
        value="{{searchKeyword}}"
        confirm-type="search"
        bindinput="onSearch"
      />
      <view wx:if="{{searchKeyword}}" class="m-search-clear" bind:tap="clearSearch">×</view>
    </view>
    <scroll-view scroll-x class="m-filter-scroll">
      <view
        class="m-filter-chip {{filterCategoryId === 0 ? 'on' : ''}}"
        data-id="0"
        bind:tap="onFilterCat"
      ><text>{{copy.merchant.filterAll}}</text></view>
      <view
        class="m-filter-chip {{filterCategoryId === item.id ? 'on' : ''}}"
        wx:for="{{cats}}"
        wx:key="id"
        data-id="{{item.id}}"
        bind:tap="onFilterCat"
      ><text>{{item.name}}</text></view>
    </scroll-view>
    <view class="m-filter-row">
      <view
        class="m-filter-chip {{filterReco === 'all' ? 'on' : ''}}"
        data-reco="all"
        bind:tap="onFilterReco"
      ><text>{{copy.merchant.filterAll}}</text></view>
      <view
        class="m-filter-chip {{filterReco === 'on' ? 'on' : ''}}"
        data-reco="on"
        bind:tap="onFilterReco"
      ><text>{{copy.merchant.filterRecoOn}}</text></view>
      <view
        class="m-filter-chip {{filterReco === 'off' ? 'on' : ''}}"
        data-reco="off"
        bind:tap="onFilterReco"
      ><text>{{copy.merchant.filterRecoOff}}</text></view>
    </view>
  </view>

  <view class="m-grid">
    <view class="m-card {{item.coverUrl ? 'has-cover' : ''}}" wx:for="{{list}}" wx:key="id">
      <image
        wx:if="{{item.coverUrl}}"
        class="m-card-bg"
        src="{{item.coverUrl}}"
        mode="aspectFill"
      />
      <view class="m-card-mask"></view>
      <view class="m-card-hit" data-id="{{item.id}}" bind:tap="edit">
        <view class="name">{{item.name}}</view>
        <view class="price">¥{{item.priceYuan}} / {{item.unitLabel}}</view>
        <view wx:if="{{item.specNote}}" class="spec">{{item.specNote}}</view>
      </view>
      <view class="m-card-toggles">
        <view
          class="m-mini-toggle"
          data-id="{{item.id}}"
          data-on="{{item.onShelf ? 1 : 0}}"
          catch:tap="toggleShelf"
        >
          <text>{{copy.merchant.shelfOn}}</text>
          <view class="switch {{item.onShelf ? 'on' : ''}}"></view>
        </view>
        <view
          class="m-mini-toggle"
          data-id="{{item.id}}"
          data-on="{{item.inStock ? 1 : 0}}"
          catch:tap="toggleStock"
        >
          <text>{{copy.merchant.stockOn}}</text>
          <view class="switch {{item.inStock ? 'on' : ''}}"></view>
        </view>
        <view
          class="m-mini-toggle"
          data-id="{{item.id}}"
          data-on="{{item.homeRecommended ? 1 : 0}}"
          catch:tap="toggleHomeReco"
        >
          <text>{{copy.merchant.homeReco}}</text>
          <view class="switch {{item.homeRecommended ? 'on' : ''}}"></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!list.length}}" class="empty">{{emptyText}}</view>
</view>
<TabBar current="products" mode="merchant" />
