<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackground}}" />
<Header pageName="{{copy.titles.merchantProducts}}" back="{{false}}" toCustomer="{{true}}" />
<view class="page-body products-page {{selecting ? 'is-selecting' : ''}}">
  <view class="m-toolbar">
    <block wx:if="{{selecting}}">
      <button class="btn btn-ghost btn-sm" bind:tap="toggleSelectMode">{{copy.merchant.batchDone}}</button>
      <button class="btn btn-ghost btn-sm" bind:tap="toggleSelectAll">{{allVisibleSelected ? copy.merchant.batchClear : copy.merchant.batchAll}}</button>
    </block>
    <block wx:else>
      <button class="btn btn-ghost btn-sm" bind:tap="goCats">{{copy.merchant.catManage}}</button>
      <button class="btn btn-ghost btn-sm" bind:tap="toggleSelectMode">{{copy.merchant.batch}}</button>
      <button class="btn btn-cta btn-sm" bind:tap="create">{{copy.merchant.addProduct}}</button>
    </block>
  </view>

  <view class="m-filters">
    <view class="m-search">
      <input
        class="m-search-input"
        placeholder="{{copy.merchant.searchPlaceholder}}"
        value="{{searchKeyword}}"
        confirm-type="search"
        bindinput="onSearch"
      />
      <view wx:if="{{searchKeyword}}" class="m-search-clear" bind:tap="clearSearch">×</view>
    </view>
    <scroll-view
      scroll-x
      class="m-filter-scroll"
      scroll-into-view="{{catIntoView}}"
      scroll-with-animation
      enhanced
      show-scrollbar="{{false}}"
    >
      <view class="m-filter-track">
        <view
          id="cat-0"
          class="m-filter-chip {{filterCategoryId === 0 ? 'on' : ''}}"
          data-id="0"
          bind:tap="onFilterCat"
        ><text>{{copy.merchant.filterAll}}</text></view>
        <view
          id="cat-{{item.id}}"
          class="m-filter-chip {{filterCategoryId === item.id ? 'on' : ''}}"
          wx:for="{{cats}}"
          wx:key="id"
          data-id="{{item.id}}"
          bind:tap="onFilterCat"
        ><text>{{item.name}}</text></view>
      </view>
    </scroll-view>
    <view class="m-filter-row">
      <view
        class="m-filter-chip {{filterReco === 'all' ? 'on' : ''}}"
        data-reco="all"
        bind:tap="onFilterReco"
      ><text>{{copy.merchant.filterAll}}</text></view>
      <view
        class="m-filter-chip {{filterReco === 'on' ? 'on' : ''}}"
        data-reco="on"
        bind:tap="onFilterReco"
      ><text>{{copy.merchant.filterRecoOn}}</text></view>
      <view
        class="m-filter-chip {{filterReco === 'off' ? 'on' : ''}}"
        data-reco="off"
        bind:tap="onFilterReco"
      ><text>{{copy.merchant.filterRecoOff}}</text></view>
      <view
        class="m-filter-chip {{filterShelf === 'on' ? 'on' : ''}}"
        data-shelf="on"
        bind:tap="onFilterShelf"
      ><text>{{copy.merchant.filterShelfOn}}</text></view>
      <view
        class="m-filter-chip {{filterShelf === 'off' ? 'on' : ''}}"
        data-shelf="off"
        bind:tap="onFilterShelf"
      ><text>{{copy.merchant.filterShelfOff}}</text></view>
      <view
        class="m-filter-chip {{filterStock === 'out' ? 'on' : ''}}"
        bind:tap="onFilterStock"
      ><text>{{copy.merchant.filterSoldOut}}</text></view>
    </view>
  </view>

  <view class="m-grid">
    <view class="m-card {{item.coverUrl ? 'has-cover' : ''}} {{item.onShelf ? '' : 'is-off'}} {{selecting && item.selected ? 'is-selected' : ''}}" wx:for="{{list}}" wx:key="id">
      <image wx:if="{{item.coverUrl}}" class="m-bg" src="{{item.coverUrl}}" mode="aspectFill" />
      <view wx:if="{{item.coverUrl}}" class="m-bg-mask"></view>
      <view class="m-card-hit" data-id="{{item.id}}" bind:tap="onCard">
        <view wx:if="{{selecting}}" class="m-check {{item.selected ? 'on' : ''}}">{{item.selected ? '✓' : ''}}</view>
        <view class="m-meta">
          <view class="name">{{item.name}}</view>
          <view class="price">¥{{item.priceYuan}}<text class="unit"> / {{item.unitLabel}}</text></view>
          <view wx:if="{{item.specNote}}" class="spec">{{item.specNote}}</view>
        </view>
      </view>
      <view wx:if="{{!selecting}}" class="m-actions">
        <view
          class="m-act {{item.onShelf ? 'on' : ''}}"
          data-id="{{item.id}}"
          data-on="{{item.onShelf ? 1 : 0}}"
          catch:tap="toggleShelf"
        >{{item.onShelf ? copy.merchant.shelfOn : copy.merchant.shelfOff}}</view>
        <view
          class="m-act {{item.inStock ? 'on' : 'warn'}}"
          data-id="{{item.id}}"
          data-on="{{item.inStock ? 1 : 0}}"
          catch:tap="toggleStock"
        >{{item.inStock ? copy.merchant.stockOn : copy.merchant.stockOff}}</view>
        <view
          class="m-act {{item.homeRecommended ? 'on' : ''}}"
          data-id="{{item.id}}"
          data-on="{{item.homeRecommended ? 1 : 0}}"
          catch:tap="toggleHomeReco"
        >{{copy.merchant.homeRecoShort}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!list.length}}" class="empty">{{emptyText}}</view>
</view>
<view wx:if="{{selecting}}" class="batch-bar">
  <view class="batch-count">{{selectedLabel}}</view>
  <scroll-view scroll-x class="batch-scroll" enhanced show-scrollbar="{{false}}">
    <view class="batch-track">
      <view class="batch-chip" data-op="ON_SHELF" bind:tap="runBatch">{{copy.merchant.shelfOn}}</view>
      <view class="batch-chip" data-op="OFF_SHELF" bind:tap="runBatch">{{copy.merchant.shelfOff}}</view>
      <view class="batch-chip" data-op="IN_STOCK" bind:tap="runBatch">{{copy.merchant.stockOn}}</view>
      <view class="batch-chip" data-op="SOLD_OUT" bind:tap="runBatch">{{copy.merchant.stockOff}}</view>
      <view class="batch-chip" data-op="RECOMMEND" bind:tap="runBatch">{{copy.merchant.homeRecoShort}}</view>
      <view class="batch-chip" data-op="UNRECOMMEND" bind:tap="runBatch">{{copy.merchant.unrecommend}}</view>
      <view class="batch-chip danger" data-op="DELETE" bind:tap="runBatch">删除</view>
    </view>
  </scroll-view>
</view>
<TabBar current="products" mode="merchant" />
