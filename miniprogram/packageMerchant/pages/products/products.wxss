.products-page {
  padding-top: 16rpx;
}

.m-toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.btn-sm {
  flex: 1;
  min-height: 72rpx;
  font-size: 26rpx;
  margin: 0;
}

.m-filters {
  margin-bottom: 16rpx;
}

.m-search {
  position: relative;
  margin-bottom: 12rpx;
}

.m-search-input {
  min-height: 68rpx;
  padding: 0 56rpx 0 24rpx;
  background: #f4f7f6;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius);
  font-size: 26rpx;
  box-sizing: border-box;
}

.m-search-clear {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  color: var(--color-muted);
  font-size: 32rpx;
}

.m-filter-scroll {
  width: 100%;
  height: 72rpx;
  margin-bottom: 12rpx;
  white-space: nowrap;
}

.m-filter-track {
  display: inline-flex;
  flex-wrap: nowrap;
  align-items: center;
  height: 72rpx;
  gap: 12rpx;
  padding-right: 8rpx;
}

.m-filter-track .m-filter-chip {
  flex-shrink: 0;
  margin: 0;
}

.m-filter-row {
  white-space: normal;
  margin-bottom: 4rpx;
  font-size: 0;
}

.m-filter-chip {
  display: inline-block;
  vertical-align: top;
  height: 56rpx;
  line-height: 52rpx;
  padding: 0 22rpx;
  margin: 0 12rpx 12rpx 0;
  box-sizing: border-box;
  border-radius: 12rpx;
  border: 2rpx solid var(--color-line);
  background: var(--color-surface);
  color: var(--color-muted);
  font-size: 24rpx;
  text-align: center;
}

.m-filter-chip text {
  font-size: 24rpx;
  line-height: 52rpx;
}

.m-filter-chip.on {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: #fff;
}

.m-filter-chip.on text {
  color: #fff;
}

.m-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: flex-start;
}

.m-card {
  position: relative;
  width: calc((100% - 16rpx) / 2);
  height: 280rpx;
  box-sizing: border-box;
  border-radius: var(--radius);
  border: 1rpx solid var(--color-line);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--color-surface);
}

.m-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 280rpx;
  z-index: 0;
}

.m-bg-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(19, 78, 74, 0.08) 0%,
    rgba(19, 78, 74, 0.28) 42%,
    rgba(19, 78, 74, 0.78) 100%
  );
}

.m-card-hit {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.m-meta {
  padding: 16rpx 16rpx 8rpx;
}

.name {
  min-height: 76rpx;
  font-weight: 600;
  font-size: 28rpx;
  line-height: 1.35;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
}

.price {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-price);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-muted);
}

.spec {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-card.has-cover .name {
  color: #fff;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.35);
}

.m-card.has-cover .price {
  color: #fde68a;
}

.m-card.has-cover .unit,
.m-card.has-cover .spec {
  color: rgba(255, 255, 255, 0.88);
}

.m-card.is-off .name,
.m-card.is-off .price {
  opacity: 0.55;
}

.m-actions {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  display: flex;
  gap: 8rpx;
  padding: 8rpx 12rpx 12rpx;
}

.m-act {
  flex: 1;
  min-width: 0;
  min-height: 64rpx;
  padding: 0 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 12rpx;
  border: 1rpx solid var(--color-line);
  background: var(--color-background);
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.2;
}

.m-act.on {
  color: #fff;
  font-weight: 600;
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.m-act.warn {
  color: var(--color-warn);
  font-weight: 600;
  background: var(--color-surface);
  border-color: var(--color-warn);
}

.empty {
  text-align: center;
  color: var(--color-muted);
  font-size: 26rpx;
  padding: 80rpx 0;
}
