.products-page {
  padding-top: 24rpx;
}

.m-toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.btn-sm {
  flex: 1;
  min-height: 80rpx;
  font-size: 28rpx;
  margin: 0;
}

.m-sku {
  background: var(--color-surface);
  border-radius: var(--radius);
  border: 2rpx solid var(--color-line);
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.cell-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.name {
  font-weight: 600;
  font-size: 30rpx;
  margin-bottom: 8rpx;
}

.spec {
  font-size: 24rpx;
  margin-top: 4rpx;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chips {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.chip {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-mist);
  color: var(--color-primary);
  font-size: 22rpx;
  margin-right: 0;
}

.chip.off,
.chip.sold {
  background: #fee2e2;
  color: var(--color-danger);
}

.linkish {
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 0;
  flex-shrink: 0;
}

.toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--color-line);
  gap: 24rpx;
}

.toggle-row.last {
  border-bottom: none;
  padding-bottom: 0;
}

.toggle-label {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 28rpx;
}

.toggle-label .sub {
  font-size: 22rpx;
  color: var(--color-muted);
  font-weight: 400;
}

.switch {
  width: 96rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #b6d4cf;
  position: relative;
  flex-shrink: 0;
  transition: background 0.2s ease;
}

.switch::after {
  content: "";
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.2s ease;
}

.switch.on {
  background: var(--color-primary);
}

.switch.on::after {
  transform: translateX(40rpx);
}
