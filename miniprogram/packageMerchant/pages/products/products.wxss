.products-page {
  padding-top: 16rpx;
}

.m-toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.btn-sm {
  flex: 1;
  min-height: 72rpx;
  font-size: 26rpx;
  margin: 0;
}

.m-filters {
  margin-bottom: 16rpx;
}

.m-search {
  position: relative;
  margin-bottom: 12rpx;
}

.m-search-input {
  min-height: 68rpx;
  padding: 0 56rpx 0 24rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-line);
  border-radius: var(--radius);
  font-size: 26rpx;
  box-sizing: border-box;
}

.m-search-clear {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  color: var(--color-muted);
  font-size: 32rpx;
}

.m-filter-scroll {
  width: 100%;
  height: 64rpx;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.m-filter-row {
  white-space: normal;
  margin-bottom: 4rpx;
  font-size: 0;
}

.m-filter-chip {
  display: inline-block;
  vertical-align: top;
  height: 56rpx;
  line-height: 52rpx;
  padding: 0 22rpx;
  margin: 0 12rpx 12rpx 0;
  box-sizing: border-box;
  border-radius: 12rpx;
  border: 2rpx solid var(--color-line);
  background: var(--color-surface);
  color: var(--color-muted);
  font-size: 24rpx;
  text-align: center;
}

.m-filter-chip text {
  font-size: 24rpx;
  line-height: 52rpx;
}

.m-filter-chip.on {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: #fff;
}

.m-filter-chip.on text {
  color: #fff;
}

.m-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.m-card {
  position: relative;
  width: calc((100% - 16rpx) / 2);
  box-sizing: border-box;
  min-height: 280rpx;
  border-radius: var(--radius);
  border: 2rpx solid var(--color-line);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--color-mist);
}

.m-card.has-cover {
  border-color: rgba(15, 118, 110, 0.25);
}

.m-card-bg {
  position: absolute;
  left: -8rpx;
  top: -8rpx;
  width: calc(100% + 16rpx);
  height: calc(100% + 16rpx);
  z-index: 0;
  filter: blur(4px);
  transform: scale(1.04);
}

.m-card-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(19, 78, 74, 0.18) 0%,
    rgba(19, 78, 74, 0.38) 42%,
    rgba(19, 78, 74, 0.78) 100%
  );
  pointer-events: none;
}

.m-card:not(.has-cover) .m-card-mask {
  background: linear-gradient(
    180deg,
    rgba(240, 253, 250, 0.2) 0%,
    rgba(204, 229, 225, 0.55) 100%
  );
}

.m-card-hit {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
  padding: 16rpx 16rpx 8rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.name {
  font-weight: 600;
  font-size: 26rpx;
  line-height: 1.35;
  color: #fff;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.25);
}

.m-card:not(.has-cover) .name {
  color: var(--color-text);
  text-shadow: none;
}

.price {
  font-size: 22rpx;
  color: #fde68a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-card:not(.has-cover) .price {
  color: var(--color-price);
}

.spec {
  font-size: 20rpx;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.85);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-card:not(.has-cover) .spec {
  color: var(--color-muted);
}

.m-card-toggles {
  position: relative;
  z-index: 2;
  padding: 10rpx 14rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  background: var(--color-surface);
  border-top: 2rpx solid var(--color-line);
}

.m-mini-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.switch {
  width: 68rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: #b6d4cf;
  position: relative;
  flex-shrink: 0;
  transition: background 0.2s ease;
}

.switch::after {
  content: "";
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.2s ease;
}

.switch.on {
  background: var(--color-primary);
}

.switch.on::after {
  transform: translateX(28rpx);
}

.empty {
  text-align: center;
  color: var(--color-muted);
  font-size: 26rpx;
  padding: 80rpx 0;
}
