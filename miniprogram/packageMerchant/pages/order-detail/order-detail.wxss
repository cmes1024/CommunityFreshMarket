.status-board {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-radius: var(--radius);
  background: var(--color-surface);
  border: 2rpx solid var(--color-line);
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.board-title {
  font-size: 36rpx;
  font-weight: 700;
}

.chip {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-right: 0;
}

.pulse-chip {
  animation: pulse-chip 1.2s ease infinite;
}

@keyframes pulse-chip {
  50% {
    filter: brightness(1.08);
  }
}

.h-steps {
  display: flex;
  margin: 0 0 32rpx;
  padding: 8rpx 0 0;
}

.h-step {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: var(--color-muted);
  position: relative;
  padding-top: 36rpx;
}

.h-step::before {
  content: "";
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--color-line);
  z-index: 1;
}

.h-step::after {
  content: "";
  position: absolute;
  top: 18rpx;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--color-line);
}

.h-step:first-child::after {
  left: 50%;
}

.h-step:last-child::after {
  right: 50%;
}

.h-step.done {
  color: var(--color-primary);
}

.h-step.done::before {
  background: var(--color-primary);
}

.h-step.done::after {
  background: var(--color-secondary);
}

.h-step.current {
  font-weight: 700;
  color: var(--color-price);
}

.h-step.current::before {
  background: var(--color-price);
  box-shadow: 0 0 0 6rpx var(--color-warn-soft);
}

.summary-card {
  background: var(--color-surface);
  border-radius: var(--radius);
  border: 2rpx solid var(--color-line);
  padding: 28rpx;
  margin-bottom: 32rpx;
}

.contact {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.items-line {
  margin-top: 16rpx;
  font-weight: 600;
  line-height: 1.45;
}

.price-line {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
}

.remark {
  margin-top: 12rpx;
}

.action-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-stack .btn {
  width: 100%;
}
