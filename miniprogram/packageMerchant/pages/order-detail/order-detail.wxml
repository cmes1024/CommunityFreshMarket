<Header pageName="{{copy.titles.orderDetail}}" back="{{true}}" />
<view class="page-body no-tab">
  <view class="status-board">
    <text class="board-title">#{{order.id}} · {{order.statusLabel}}</text>
    <text class="chip pulse-chip" wx:if="{{order.customerArrivedAt}}">{{copy.merchant.arrivedChip}}</text>
  </view>

  <view class="h-steps" wx:if="{{order.status !== 'CANCELLED'}}">
    <view
      class="h-step {{item.done ? 'done' : ''}} {{item.current ? 'current' : ''}}"
      wx:for="{{stepList}}"
      wx:key="code"
    >{{item.label}}</view>
  </view>

  <view class="summary-card">
    <view class="contact" wx:if="{{contactText}}">{{contactText}}</view>
    <view class="muted">{{fulfillText}}</view>
    <view class="items-line">{{itemsText}}</view>
    <view class="price-line">
      <text class="price">¥{{order.dueYuan || order.payYuan || order.totalYuan}}</text>
      <text class="muted"> · {{order.payNote || copy.merchant.offlinePay}}</text>
    </view>
    <view class="muted remark" wx:if="{{order.discountFen}}">券抵扣 -¥{{order.discountYuan}}（商品 ¥{{order.totalYuan}}）</view>
    <view class="muted remark" wx:if="{{order.balanceFen}}">余额抵扣 -¥{{order.balanceYuan}}</view>
    <view class="muted remark" wx:if="{{order.remark}}">备注 {{order.remark}}</view>
  </view>

  <view class="action-stack">
    <button
      class="btn btn-cta"
      wx:if="{{order.nextStatus}}"
      bind:tap="advance"
    >{{advanceText}}</button>
    <button
      class="btn btn-danger"
      wx:if="{{order.canCancel}}"
      bind:tap="cancel"
    >{{copy.merchant.cancelOrder}}</button>
  </view>
</view>
