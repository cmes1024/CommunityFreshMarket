.hint {
  font-size: 22rpx;
  color: var(--color-muted);
  line-height: 1.45;
  margin-bottom: 16rpx;
  padding: 14rpx 18rpx;
  background: var(--color-mist);
  border-radius: var(--radius);
}

.field {
  margin-bottom: 16rpx;
  min-width: 0;
}

.field-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: flex-start;
  gap: 16rpx;
}

.col-7 {
  flex: 7;
  width: 0;
}

.col-3 {
  flex: 3;
  width: 0;
}

.label {
  display: block;
  font-size: 22rpx;
  color: var(--color-muted);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.label-row .label {
  margin-bottom: 0;
  flex: 1;
  min-width: 0;
}

.label-link {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.label .muted {
  margin-left: 8rpx;
}

.field-input {
  width: 100%;
  min-height: 72rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-line);
  border-radius: var(--radius);
  padding: 0 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.field-input.picker {
  line-height: 72rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.field-textarea {
  width: 100%;
  min-height: 120rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-line);
  border-radius: var(--radius);
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.45;
  color: var(--color-text);
}

.img-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.img-head .label {
  margin-bottom: 0;
}

.live-inline {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.live-inline-label {
  font-size: 24rpx;
  color: var(--color-text);
  font-weight: 600;
}

.img-live-hint {
  margin: -4rpx 0 12rpx;
}

.live-slot {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.img-tile {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--color-line);
  overflow: hidden;
  background: var(--color-mist);
  box-sizing: border-box;
}

.img-add {
  border-style: dashed;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.img {
  width: 100%;
  height: 100%;
}

.img-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.field-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-line);
  border-radius: var(--radius);
  box-sizing: border-box;
}

.field-toggle .label {
  margin-bottom: 4rpx;
  color: var(--color-text);
  font-size: 28rpx;
  white-space: normal;
}

.toggle-hint {
  font-size: 22rpx;
  color: var(--color-muted);
  line-height: 1.4;
}

.switch {
  width: 76rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #b6d4cf;
  position: relative;
  flex-shrink: 0;
  transition: background 0.2s ease;
}

.switch::after {
  content: "";
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.2s ease;
}

.switch.on {
  background: var(--color-primary);
}

.switch.on::after {
  transform: translateX(32rpx);
}

.full {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  margin: 20rpx 0 0 !important;
  padding-top: 0;
  padding-bottom: 0;
  line-height: 1;
  box-sizing: border-box;
}
