.counter-page {
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.block {
  margin-bottom: 20rpx;
  padding: 28rpx 24rpx 24rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius);
}

.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.bubble-entry {
  position: relative;
  flex: none;
  padding: 4rpx 16rpx 4rpx 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--color-primary);
}

.bubble-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-danger);
}

.who {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  background: var(--color-background);
  border-radius: 20rpx;
}

.who-avatar,
.who-fallback {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.who-fallback {
  background: var(--color-cta);
  color: var(--color-on-ink);
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.who-meta {
  min-width: 0;
  flex: 1;
}

.who-name {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.who-from {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.who-empty {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-muted);
  line-height: 1.4;
}

.bubble-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.person {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  padding: 6rpx 18rpx 6rpx 6rpx;
  background: var(--color-fill);
  border-radius: 999rpx;
  border: 2rpx solid var(--color-line);
  box-sizing: border-box;
}

.person-avatar,
.person-fallback {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.person-fallback {
  background: var(--color-cta);
  color: var(--color-on-ink);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.person-name {
  margin-left: 10rpx;
  font-size: 26rpx;
  line-height: 1.3;
  color: var(--color-text);
}

.person.on {
  background: var(--color-cta);
  border-color: var(--color-cta);
}

.person.on .person-name {
  color: var(--color-on-primary);
}

.person.on .person-fallback {
  background: var(--color-surface);
  color: var(--color-cta);
}

.bubble-sheet {
  background: var(--color-background);
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.grab {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--color-line);
  margin: 16rpx auto 8rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 32rpx 16rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

.sheet-close {
  font-size: 26rpx;
  line-height: 1.3;
  color: var(--color-muted);
  padding: 8rpx 0 8rpx 24rpx;
}

.bubble-list {
  max-height: 56vh;
  padding: 0 32rpx 8rpx;
  box-sizing: border-box;
}

.bubble-list .empty {
  padding: 80rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
}

.hint {
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.4;
}

.scan-btn {
  width: 100%;
  margin-top: 20rpx;
}

.amount {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 8rpx 8rpx 8rpx 24rpx;
  background: var(--color-fill);
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
}

.yen {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}

.amount-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  margin-left: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.amount-ph {
  color: var(--color-muted);
  font-weight: 400;
}

.preview {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-cta);
}

.submit {
  width: 100%;
}
