.orders-page {
  padding-bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom));
  min-height: 100%;
  box-sizing: border-box;
}

.notify-bar {
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.notify-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--color-muted);
  line-height: 1.45;
}

.notify-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 22rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-on-primary);
  background: var(--color-cta);
  border-radius: var(--radius-pill);
  border: none;
}

.notify-btn::after {
  border: none;
}

.status-nav {
  position: sticky;
  z-index: 10;
  display: flex;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-line);
}

.status-tab {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  padding: 16rpx 4rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  box-sizing: border-box;
}

.status-tab.active {
  color: var(--color-primary);
  font-weight: 700;
}

.status-tab.active::after {
  content: "";
  position: absolute;
  left: 18%;
  right: 18%;
  bottom: 0;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--color-primary);
}

.tab-badge {
  flex-shrink: 0;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--color-mist);
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.tab-badge.warn {
  background: var(--color-warn-soft);
  color: var(--color-warn);
}

.status-tab.active .tab-badge {
  background: var(--color-primary);
  color: var(--color-on-primary);
}

.status-tab.active .tab-badge.warn {
  background: var(--color-price);
  color: var(--color-on-primary);
}

.order-list {
  padding-top: 20rpx;
}

.order-list.is-urgent {
  background: linear-gradient(180deg, var(--color-warn-soft) 0%, var(--color-background) 240rpx);
}

.order-card {
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  background: var(--color-surface);
  border-radius: var(--radius);
  border: 2rpx solid var(--color-line);
  box-sizing: border-box;
}

.order-card.urgent {
  border-color: var(--color-warn-line);
  background: var(--color-warn-soft);
}

.order-card.pulse {
  animation: pulse-border 1.6s ease infinite;
}

@keyframes pulse-border {
  50% {
    border-color: var(--color-primary);
  }
}

.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.chip {
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-mist);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 0;
}

.chip.warn {
  background: var(--color-warn-soft);
  color: var(--color-warn);
}

.chip.pulse-chip {
  background: var(--color-primary);
  color: var(--color-on-primary);
  animation: pulse-chip 1.2s ease infinite;
}

@keyframes pulse-chip {
  50% {
    filter: brightness(1.08);
  }
}

.items {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.fulfill {
  font-size: 24rpx;
  color: var(--color-muted);
  margin-bottom: 20rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.act {
  padding: 0 28rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 600;
  border: 2rpx solid var(--color-line);
  background: var(--color-surface);
  color: var(--color-text);
  margin: 0;
}

.act::after {
  border: none;
}

.act.primary {
  background: var(--color-cta);
  color: var(--color-on-primary);
  border-color: var(--color-cta);
}

.empty-hint {
  padding: 24rpx 32rpx 32rpx;
  font-size: 26rpx;
  color: var(--color-muted);
}
