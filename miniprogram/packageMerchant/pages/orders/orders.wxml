<Header pageName="{{copy.titles.merchantOrders}}" back="{{false}}" toCustomer="{{true}}" />
<view class="orders-page">
  <view class="notify-bar">
    <view class="notify-text">{{copy.merchant.notifyBar}}</view>
    <button class="notify-btn" bind:tap="enableNotify">{{copy.merchant.notifyEnable}}</button>
  </view>
  <view class="status-nav" style="top: {{stickyTop}}px;">
    <view
      class="status-tab {{activeTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bind:tap="onTab"
    >
      <text>{{item.label}}</text>
      <text wx:if="{{item.count}}" class="tab-badge {{item.key === 'urgent' ? 'warn' : ''}}">{{item.count}}</text>
    </view>
  </view>
  <view class="order-list {{activeTab === 'urgent' ? 'is-urgent' : ''}}">
    <view
      class="order-card {{item.isUrgent ? 'urgent' : ''}} {{item.pulse ? 'pulse' : ''}}"
      wx:for="{{visible}}"
      wx:key="id"
      data-id="{{item.id}}"
      bind:tap="go"
    >
      <view class="top">
        <text>#{{item.id}}</text>
        <text class="chip {{item.chipWarn ? 'warn' : ''}} {{item.chipPulse ? 'pulse-chip' : ''}}">{{item.chipLabel}}</text>
      </view>
      <view class="items">{{item.itemsText}}</view>
      <view class="fulfill">{{item.fulfillText}}</view>
      <view class="actions">
        <button
          wx:if="{{item.canCancel}}"
          class="act"
          catch:tap="onCancel"
          data-id="{{item.id}}"
        >{{copy.merchant.cancel}}</button>
        <button
          wx:if="{{item.nextStatus}}"
          class="act primary"
          catch:tap="onAdvance"
          data-id="{{item.id}}"
          data-status="{{item.status}}"
        >{{item.primaryLabel}}</button>
      </view>
    </view>
    <view wx:if="{{!visible.length}}" class="empty-hint">{{emptyText}}</view>
  </view>
</view>
<TabBar current="orders" mode="merchant" />
