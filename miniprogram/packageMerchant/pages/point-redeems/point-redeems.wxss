.wave-page {
  padding: 16rpx 0 48rpx;
}
.sec-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 8rpx;
}
.sec {
  padding: 0;
  font-size: 26rpx;
  font-weight: 600;
}
.card {
  margin: 0 32rpx 16rpx;
  padding: 24rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius);
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.label {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
}
.head-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pick-btn {
  flex: none;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
  line-height: 1;
  padding: 8rpx 0 8rpx 16rpx;
}
.pick-clear {
  flex: none;
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 400;
}
.field-row {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.field-name {
  flex: 7;
  width: 0;
  min-width: 0;
}
.field-cost {
  flex: 3;
  width: 0;
  min-width: 0;
}
.row-actions,
.actions {
  flex: none;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.pending-entry {
  position: relative;
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx 8rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
  white-space: nowrap;
  line-height: 1;
}
.pending-dot {
  position: absolute;
  top: 4rpx;
  right: 6rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-danger);
}
.pending-card {
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid var(--color-line);
}
.pending-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 16rpx;
}
.pending-actions .btn {
  width: auto !important;
  flex: none;
  margin: 0;
  padding: 0 24rpx;
}
.picker-sheet {
  height: 72vh;
  display: flex;
  flex-direction: column;
  background: var(--color-surface);
  box-sizing: border-box;
  padding: 12rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
}
.grab {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--color-line);
  margin: 8rpx auto 16rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
}
.sheet-close {
  font-size: 26rpx;
  color: var(--color-muted);
  padding: 8rpx 0 8rpx 24rpx;
}
.m-search {
  position: relative;
  margin-bottom: 12rpx;
}
.m-search-input {
  min-height: 72rpx;
  padding: 0 64rpx 0 24rpx;
  background: #f4f7f6;
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
  font-size: 28rpx;
}
.m-search-clear {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  color: var(--color-muted);
  font-size: 32rpx;
}
.picker-list {
  flex: 1;
  height: 0;
  min-height: 240rpx;
}
.picker-row {
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid var(--color-line);
  font-size: 30rpx;
}
.picker-row.on {
  color: var(--color-primary);
  font-weight: 600;
}
.field-input {
  display: block;
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  margin: 0;
  box-sizing: border-box;
  background: #f4f7f6;
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
  font-size: 28rpx;
}
.add-btn {
  width: 100% !important;
  margin: 0;
  box-sizing: border-box;
}
.row-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-line);
}
.row-item .btn {
  width: auto !important;
  flex: none;
  margin: 0;
  padding: 0 24rpx;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}
.sm {
  font-size: 24rpx;
  margin-top: 6rpx;
}
.empty {
  padding: 48rpx;
  text-align: center;
}
.btn-sm {
  min-height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
}
.grow {
  flex: 1;
  min-width: 0;
}
