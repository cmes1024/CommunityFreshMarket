.wave-page {
  padding: 16rpx 0 48rpx;
}
.row-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 40rpx;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-line);
}
.title {
  font-size: 30rpx;
  font-weight: 600;
}
.sm {
  font-size: 24rpx;
  margin-top: 6rpx;
}
.empty {
  padding: 48rpx;
  text-align: center;
}
.btn-sm {
  min-height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
  margin: 0;
}
.grow {
  flex: 1;
  min-width: 0;
}
