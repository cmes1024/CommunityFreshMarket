.cashier-page {
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}
.toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.card {
  background: var(--color-surface);
  border-radius: var(--radius);
  padding: 24rpx;
  border: 1rpx solid var(--color-line);
  margin-bottom: 24rpx;
}
.row-line {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}
.price.strong {
  font-weight: 700;
  color: var(--color-cta);
}
.sec {
  font-size: 26rpx;
  font-weight: 600;
  margin: 24rpx 0 12rpx;
}
.checkin {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--color-surface);
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid var(--color-line);
}
.checkin.on {
  border-color: var(--color-primary);
}
.scan-btn {
  margin-bottom: 16rpx;
}
.reason {
  margin-top: 12rpx;
}
.remove {
  margin-left: 16rpx;
}
.link {
  color: var(--color-primary);
  font-size: 26rpx;
}
.prod-scroll {
  white-space: nowrap;
  margin-bottom: 12rpx;
}
.prod-chip {
  display: inline-block;
  padding: 12rpx 20rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: var(--color-mist);
  font-size: 24rpx;
}
.prod-chip.on {
  background: var(--color-cta);
  color: #fff;
}
.add-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 16rpx;
}
.field-input {
  background: #f4f7f6;
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-line);
  font-size: 28rpx;
}
.empty {
  text-align: center;
  padding: 24rpx;
  font-size: 26rpx;
}
.complete {
  margin-top: 32rpx;
}
.grow {
  flex: 1;
  min-width: 0;
}
.sm {
  font-size: 22rpx;
  margin-top: 8rpx;
}
