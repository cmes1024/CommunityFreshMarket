<Header pageName="{{copy.titles.merchantProfile}}" back="{{false}}" />
<view class="profile-page">
  <view class="profile-head">
    <view class="avatar">{{avatarText}}</view>
    <view class="meta">
      <view class="name">{{rolePrefix}} · {{storeName}}</view>
      <view class="sub">{{copy.merchant.roleHint}}</view>
    </view>
  </view>

  <view class="shortcut-grid">
    <view class="shortcut {{inboxCount ? 'shortcut-alert' : ''}}" hover-class="shortcut-on" bind:tap="goInbox">
      <view class="mark"><image src="/images/profile-inbox.svg" mode="aspectFit" /></view>
      <view wx:if="{{inboxCount}}" class="inbox-badge">{{inboxCount > 99 ? '99+' : inboxCount}}</view>
      <view class="shortcut-copy">
        <view class="shortcut-title">{{copy.merchant.inbox}}</view>
        <view class="shortcut-sub {{inboxCount ? 'alert' : ''}}">{{inboxCount ? '有人申请更新图片' : copy.merchant.inboxSub}}</view>
      </view>
    </view>
    <view class="shortcut" hover-class="shortcut-on" bind:tap="goCounter">
      <view wx:if="{{bubbleCount}}" class="inbox-badge">{{bubbleCount > 99 ? '99+' : bubbleCount}}</view>
      <view class="mark mark-green"><image src="/images/profile-points.svg" mode="aspectFit" /></view>
      <view class="shortcut-copy">
        <view class="shortcut-title">{{copy.merchant.counterPoints}}</view>
        <view class="shortcut-sub">{{copy.merchant.counterPointsSub}}</view>
      </view>
    </view>
    <view class="shortcut" hover-class="shortcut-on" bind:tap="goCoupons">
      <view class="mark"><image src="/images/profile-coupon.svg" mode="aspectFit" /></view>
      <view class="shortcut-copy">
        <view class="shortcut-title">{{copy.merchant.merchantCoupons}}</view>
        <view class="shortcut-sub">{{copy.merchant.merchantCouponsSub}}</view>
      </view>
    </view>
    <view class="shortcut" hover-class="shortcut-on" bind:tap="goPointRedeems">
      <view class="mark mark-amber"><image src="/images/profile-redeem.svg" mode="aspectFit" /></view>
      <view class="shortcut-copy">
        <view class="shortcut-title">{{copy.merchant.pointRedeems}}</view>
        <view class="shortcut-sub">{{copy.merchant.pointRedeemsSub}}</view>
      </view>
    </view>
    <view class="shortcut shortcut-wide" hover-class="shortcut-on" bind:tap="onInvite">
      <view class="mark"><image src="/images/profile-invite.svg" mode="aspectFit" /></view>
      <view class="shortcut-copy">
        <view class="shortcut-title">{{copy.merchant.inviteStaff}}</view>
        <view class="shortcut-sub">{{copy.merchant.inviteStaffSub}}</view>
      </view>
    </view>
  </view>

  <view class="merchant-entry alt" hover-class="entry-on" bind:tap="backCustomer">
    <view class="me-title">{{copy.merchant.backCustomer}}</view>
    <view class="me-sub">{{copy.merchant.backCustomerSub}}</view>
  </view>
</view>

<page-container
  show="{{inviteShow}}"
  round="{{true}}"
  overlay="{{true}}"
  position="bottom"
  close-on-slide-down="{{true}}"
  custom-style="height: auto;"
  bind:clickoverlay="closeInvite"
  bind:afterleave="closeInvite"
>
  <view class="invite-sheet" catch:tap="noop">
    <view class="grab"></view>
    <view class="sheet-head">
      <view class="sheet-title">{{copy.merchant.inviteTitle}}</view>
      <view class="sheet-close" bind:tap="closeInvite">关闭</view>
    </view>
    <view class="invite-desc">{{copy.merchant.inviteDesc}}</view>
    <image
      wx:if="{{inviteQrSrc}}"
      class="invite-qr"
      src="{{inviteQrSrc}}"
      mode="aspectFit"
      show-menu-by-longpress="{{false}}"
    />
    <view wx:else class="invite-qr-empty muted">{{copy.merchant.inviteQrFail}}</view>
    <view class="invite-code-line" wx:if="{{inviteCode}}">
      {{copy.merchant.inviteCodeHint}} {{inviteCode}}
    </view>
    <view class="invite-url-line" wx:if="{{inviteUrl}}">{{inviteUrl}}</view>
    <button class="btn btn-ghost invite-rotate" bind:tap="rotateInvite">{{copy.merchant.inviteRotate}}</button>
  </view>
</page-container>

<TabBar current="profile" mode="merchant" />
