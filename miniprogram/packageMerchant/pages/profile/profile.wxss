.profile-page {
  padding: 24rpx 24rpx calc(var(--tabbar-height) + env(safe-area-inset-bottom) + 24rpx);
  min-height: 100%;
  box-sizing: border-box;
}

.profile-head {
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 16rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius);
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: var(--color-on-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 40rpx;
  flex-shrink: 0;
}

.meta .name {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.meta .sub {
  font-size: 24rpx;
  color: var(--color-muted);
}

.shortcut-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.shortcut {
  position: relative;
  width: calc((100% - 16rpx) / 2);
  box-sizing: border-box;
  min-height: 176rpx;
  padding: 24rpx 20rpx 20rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.shortcut-on {
  background: var(--color-mist);
}

.shortcut-alert {
  background: var(--color-danger-soft);
  border-color: var(--color-danger-line);
}

.shortcut-alert.shortcut-on {
  background: var(--color-danger-soft);
}

.mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--color-mist);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.mark-green {
  background: var(--color-mist);
}

.mark-yen {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-cta);
  line-height: 1;
}

.mark-amber {
  background: var(--color-warn-soft);
}

.mark image {
  width: 36rpx;
  height: 36rpx;
}

.shortcut-copy {
  min-width: 0;
  width: 100%;
  flex: 1;
}

.shortcut-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
}

.shortcut-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-muted);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shortcut-sub.alert {
  color: var(--color-danger);
  font-weight: 600;
}

.inbox-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--color-danger);
  color: var(--color-on-primary);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
  box-sizing: border-box;
}

.merchant-entry {
  margin: 16rpx 0 0;
  padding: 32rpx;
  border-radius: var(--radius);
  background: var(--color-primary);
  color: var(--color-on-primary);
}

.entry-on {
  opacity: 0.88;
}

.merchant-entry.alt {
  background: var(--color-ink);
}

.me-title {
  font-size: 30rpx;
  font-weight: 600;
}

.me-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 300;
  opacity: 0.85;
}

.invite-sheet {
  padding: 12rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--color-surface);
  border-radius: 24rpx 24rpx 0 0;
}

.grab {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--color-line);
  margin: 8rpx auto 20rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
}

.sheet-close {
  font-size: 26rpx;
  color: var(--color-muted);
  padding: 8rpx;
}

.invite-desc {
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.45;
  margin-bottom: 20rpx;
}

.invite-qr {
  display: block;
  width: 360rpx;
  height: 360rpx;
  margin: 0 auto 16rpx;
  background: var(--color-surface);
  border-radius: 12rpx;
}

.invite-qr-empty {
  text-align: center;
  padding: 48rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.invite-code-line {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-muted);
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.invite-url-line {
  text-align: center;
  font-size: 20rpx;
  color: var(--color-muted);
  line-height: 1.4;
  word-break: break-all;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
  opacity: 0.85;
}

.invite-rotate {
  width: 100%;
  min-height: 80rpx;
  font-size: 28rpx;
}
