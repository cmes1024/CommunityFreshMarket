.profile-page {
  padding-bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom));
  min-height: 100%;
  box-sizing: border-box;
}

.profile-head {
  display: flex;
  gap: 28rpx;
  align-items: center;
  padding: 48rpx 40rpx;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-line);
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #f0fdfa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 40rpx;
  flex-shrink: 0;
}

.meta .name {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.meta .sub {
  font-size: 24rpx;
  color: var(--color-muted);
}

.menu-list {
  background: var(--color-surface);
}

.menu-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 0 40rpx;
  font-size: 30rpx;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-line);
}

.menu-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.menu-hint {
  font-size: 22rpx;
  color: var(--color-danger);
  font-weight: 600;
}

.menu-side {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.inbox-pending {
  background: #fef2f2;
}

.inbox-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--color-danger);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
  box-sizing: border-box;
}

.arrow {
  color: var(--color-muted);
  font-size: 36rpx;
}

.merchant-entry {
  margin: 32rpx 24rpx 0;
  padding: 32rpx;
  border-radius: var(--radius);
  background: var(--color-primary);
  color: #fff;
}

.merchant-entry.alt {
  background: #3f6f6a;
}

.me-title {
  font-size: 30rpx;
  font-weight: 600;
}

.me-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 300;
  opacity: 0.85;
}

.invite-sheet {
  padding: 12rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--color-surface);
  border-radius: 24rpx 24rpx 0 0;
}

.grab {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--color-line);
  margin: 8rpx auto 20rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
}

.sheet-close {
  font-size: 26rpx;
  color: var(--color-muted);
  padding: 8rpx;
}

.invite-desc {
  font-size: 24rpx;
  color: var(--color-muted);
  line-height: 1.45;
  margin-bottom: 20rpx;
}

.invite-qr {
  display: block;
  width: 360rpx;
  height: 360rpx;
  margin: 0 auto 16rpx;
  background: #fff;
  border-radius: 12rpx;
}

.invite-qr-empty {
  text-align: center;
  padding: 48rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.invite-code-line {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-muted);
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.invite-url-line {
  text-align: center;
  font-size: 20rpx;
  color: var(--color-muted);
  line-height: 1.4;
  word-break: break-all;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
  opacity: 0.85;
}

.invite-rotate {
  width: 100%;
  min-height: 80rpx;
  font-size: 28rpx;
}
