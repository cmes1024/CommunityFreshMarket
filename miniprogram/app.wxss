@import "/styles/variable.wxss";
@import "/styles/common.wxss";

page {
  /* 品牌：一条青绿。主按钮与导航同色 */
  --color-primary: #0f766e;
  --color-primary-pressed: #115e59;
  --color-secondary: #0d9488;
  --color-cta: #0f766e;
  --color-on-primary: #ffffff;
  --color-on-ink: #f0fdfa;

  /* 表面 */
  --color-background: #f0fdfa;
  --color-surface: #ffffff;
  --color-mist: #ccfbf1;
  --color-fill: #f4f7f6;
  --color-line: #cce5e1;
  --color-ink: #0f3d38;

  /* 文字 */
  --color-text: #134e4a;
  --color-muted: #5b7c78;

  /* 语义：价格 / 待处理 / 危险。正向状态复用 mist + primary */
  --color-price: #d97706;
  --color-price-on-dark: #fde68a;
  --color-warn: #b45309;
  --color-warn-soft: #fef6e8;
  --color-warn-line: #f3d7a8;
  --color-danger: #dc2626;
  --color-danger-soft: #fef2f2;
  --color-danger-line: #fecaca;

  /* 无图占位 */
  --color-ph-veg: #c5e8e1;
  --color-ph-fruit: #f4e0b0;
  --color-ph-sold: #e4eae8;
  --color-ph-deep: #b7d4ce;
  --color-scrim: rgba(19, 78, 74, 0.5);
  --shadow-float: 0 16rpx 48rpx rgba(15, 118, 110, 0.16);
  --shadow-lift: 0 16rpx 48rpx rgba(15, 118, 110, 0.2);
  --color-hero-top: rgba(15, 61, 56, 0.28);
  --color-hero-bottom: rgba(15, 61, 56, 0.55);
  --color-card-top: rgba(19, 78, 74, 0.08);
  --color-card-mid: rgba(19, 78, 74, 0.28);
  --color-card-bottom: rgba(19, 78, 74, 0.78);
  --color-check-bg: rgba(19, 78, 74, 0.35);
  --radius: 24rpx;
  --radius-pill: 999rpx;
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 32rpx;
  --space-lg: 48rpx;
  --tabbar-height: 116rpx;
  font-family: "PingFang SC", "Noto Sans SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background-color: var(--color-background);
  touch-action: manipulation;
}

.page-body {
  padding: 24rpx 32rpx calc(var(--tabbar-height) + env(safe-area-inset-bottom) + 24rpx);
  box-sizing: border-box;
}

.page-body.no-tab {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius);
  padding: 16rpx 28rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--color-line);
  gap: 10rpx;
  display: flex;
  flex-direction: column;
}

.price {
  color: var(--color-price);
  font-weight: 700;
}

.muted {
  color: var(--color-muted);
  font-size: 24rpx;
}

.btn {
  min-height: 88rpx;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
  padding: 0 32rpx;
  border: none;
}
.btn::after { border: none; }

.btn-cta {
  background: var(--color-cta);
  color: var(--color-on-primary);
}

.btn-primary {
  background: var(--color-primary);
  color: var(--color-on-primary);
}

.btn-ghost {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-line);
}

.btn-danger {
  background: transparent;
  color: var(--color-danger);
  border: 2rpx solid var(--color-danger-line);
}

.btn[disabled] {
  opacity: 0.5;
}

.row {
  display: flex;
  align-items: center;
}

.space-between {
  justify-content: space-between;
}

.grow {
  flex: 1;
  min-width: 0;
}

.empty {
  padding: 120rpx 48rpx;
  text-align: center;
  color: var(--color-muted);
}

.chip {
  padding: 12rpx 24rpx;
  border-radius: var(--radius-pill);
  background: var(--color-mist);
  color: var(--color-primary);
  font-size: 24rpx;
  margin-right: 12rpx;
}

.chip.active {
  background: var(--color-primary);
  color: var(--color-on-primary);
}

/* 列表里的数量选择器：直接写成 view，不再为每张卡建一个 Stepper 组件实例。
   一屏二三十张卡就是二三十个实例，真机上实例创建与数据观察都有成本。 */
.stepper {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  line-height: 1;
}
.stepper .step-btn {
  width: 36rpx;
  height: 36rpx;
  min-width: 36rpx;
  min-height: 36rpx;
  max-width: 36rpx;
  max-height: 36rpx;
  border-radius: 50%;
  background: var(--color-cta);
  color: var(--color-on-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}
.stepper .step-btn.minus {
  background: var(--color-surface);
  color: var(--color-cta);
  border: 2rpx solid var(--color-cta);
}
.stepper .step-btn.off {
  opacity: 0.35;
}
.stepper .val {
  min-width: 32rpx;
  padding: 0 4rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1;
}
.stepper.sm .step-btn {
  width: 28rpx;
  height: 28rpx;
  min-width: 28rpx;
  min-height: 28rpx;
  max-width: 28rpx;
  max-height: 28rpx;
  font-size: 20rpx;
}
.stepper.sm .val {
  min-width: 28rpx;
  font-size: 20rpx;
}
