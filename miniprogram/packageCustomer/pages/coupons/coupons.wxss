@import "../points/points.wxss";

.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.tabs.with-link {
  margin-bottom: 12rpx;
}
.history-link {
  margin-bottom: 20rpx;
  padding-right: 8rpx;
  text-align: right;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--color-muted);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 16rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  font-size: 28rpx;
}
.tab.on {
  background: var(--color-mist);
  border-color: var(--color-cta);
  font-weight: 600;
}
.coupon {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-surface);
  border-radius: var(--radius);
  border: 1rpx solid var(--color-line);
}
.coupon-main {
  flex: 1;
  min-width: 0;
}
.coupon-title {
  font-size: 30rpx;
  font-weight: 600;
}
.coupon-sub {
  font-size: 24rpx;
  color: var(--color-muted);
  margin-top: 6rpx;
}
.btn-sm {
  flex: none;
  width: auto !important;
  min-width: 148rpx;
  height: 64rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
  margin: 0;
  box-sizing: border-box;
}
.coupon-state {
  flex: none;
  min-width: 148rpx;
  height: 64rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
}
.coupon-state.claimed {
  background: var(--color-mist);
  color: var(--color-primary);
}
.coupon-state.soldout,
.coupon-state.past {
  background: var(--color-fill);
  color: var(--color-muted);
  border: 1rpx solid var(--color-line);
}
.coupon-state.inuse {
  background: var(--color-warn-soft);
  color: var(--color-warn);
}
.history-sheet {
  background: var(--color-background);
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}
.grab {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--color-line);
  margin: 16rpx auto 8rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 32rpx 16rpx;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}
.sheet-close {
  font-size: 26rpx;
  line-height: 1.3;
  color: var(--color-muted);
  padding: 8rpx 0 8rpx 24rpx;
}
.history-list {
  max-height: 56vh;
  overflow-y: auto;
  padding: 0 32rpx;
  box-sizing: border-box;
}
.history-list .empty {
  padding: 80rpx 32rpx;
}
