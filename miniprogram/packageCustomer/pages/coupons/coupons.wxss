@import "../points/points.wxss";

.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 16rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  font-size: 28rpx;
}
.tab.on {
  background: var(--color-mist);
  border-color: var(--color-cta);
  font-weight: 600;
}
.coupon {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-surface);
  border-radius: var(--radius);
  border: 1rpx solid var(--color-line);
}
.coupon-main {
  flex: 1;
  min-width: 0;
}
.coupon-title {
  font-size: 30rpx;
  font-weight: 600;
}
.coupon-sub {
  font-size: 24rpx;
  color: var(--color-muted);
  margin-top: 6rpx;
}
.btn-sm {
  min-height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
  margin: 0;
}
