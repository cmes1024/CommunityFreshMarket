.code-page {
  padding: 24rpx 32rpx 48rpx;
}
.card {
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius);
  padding: 32rpx 28rpx 36rpx;
}
.hint {
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--color-muted);
  text-align: center;
  margin-bottom: 24rpx;
}
.qr {
  display: block;
  width: 420rpx;
  height: 420rpx;
  margin: 0 auto 16rpx;
  background: var(--color-surface);
  border-radius: 12rpx;
}
.qr-empty {
  text-align: center;
  padding: 80rpx 24rpx;
  font-size: 26rpx;
}
.nick {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 28rpx;
}
.bubble {
  margin-top: 8rpx;
}
