<Header pageName="{{copy.titles.orderDetail}}" back="{{true}}" />
<view class="page-body no-tab">
  <view class="card status-card">
    <view class="status {{order.status === 'CANCELLED' ? 'cancelled' : ''}}">{{order.statusLabel}}</view>
    <view class="h-steps" wx:if="{{order.status !== 'CANCELLED' && stepList.length}}">
      <block wx:for="{{stepList}}" wx:key="code">
        <view class="h-line {{item.reached ? 'on' : ''}}" wx:if="{{index > 0}}"></view>
        <view class="h-node {{item.done ? 'done' : ''}} {{item.current ? 'current' : ''}}">
          <view class="h-dot"></view>
          <text class="h-label">{{item.label}}</text>
        </view>
      </block>
    </view>
  </view>
  <view class="card summary">
    <view class="item" wx:for="{{order.items}}" wx:key="productName">
      <text class="item-name">{{item.productName}}</text>
      <text class="item-qty">× {{item.qty}} {{item.unitLabel}}</text>
    </view>
    <view class="bill">
      <view class="bill-row {{order.discountFen ? '' : 'pay solo'}}">
        <text class="bill-label">合计</text>
        <text class="bill-money">¥{{order.totalYuan}}</text>
      </view>
      <view class="bill-row" wx:if="{{order.discountFen}}">
        <text class="bill-label">{{copy.checkout.couponOff}}</text>
        <text class="bill-money off">-¥{{order.discountYuan}}</text>
      </view>
      <view class="bill-row pay" wx:if="{{order.discountFen}}">
        <text class="bill-label">{{copy.checkout.payable}}</text>
        <text class="bill-money">¥{{order.payYuan}}</text>
      </view>
    </view>
    <view class="meta" wx:if="{{fulfillText}}">
      <text class="meta-k">{{fulfillLabel}}</text>
      <text class="meta-v">{{fulfillText}}</text>
    </view>
    <view class="meta" wx:if="{{order.remark}}">
      <text class="meta-k">备注</text>
      <text class="meta-v">{{order.remark}}</text>
    </view>
  </view>
  <view class="actions">
    <button class="btn btn-cta" wx:if="{{order.canArrive}}" bind:tap="arrive">我到店了</button>
    <button class="btn btn-cta" wx:if="{{order.canReorder}}" bind:tap="reorder">再来一单</button>
    <button class="btn btn-ghost" open-type="contact">微信客服</button>
    <button class="btn btn-danger" wx:if="{{order.canCancel}}" bind:tap="cancel">取消预约</button>
  </view>
</view>
