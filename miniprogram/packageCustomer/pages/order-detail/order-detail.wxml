<Header pageName="{{copy.titles.orderDetail}}" back="{{true}}" />
<view class="page-body no-tab">
  <view class="card">
    <view class="row steps">
      <view wx:for="{{stepList}}" wx:key="code" class="step {{item.done ? 'done' : ''}}">{{item.label}}</view>
    </view>
    <view class="status">{{order.statusLabel}}</view>
  </view>
  <view class="card">
    <view wx:for="{{order.items}}" wx:key="productName">{{item.productName}} × {{item.qty}} {{item.unitLabel}}</view>
    <view class="row space-between"><text>合计</text><text class="price">¥{{order.totalYuan}}</text></view>
    <view class="muted">{{order.fulfillment === 'PICKUP' ? order.pickupSlotLabel : '尽快配送'}}</view>
    <view class="muted" wx:if="{{order.remark}}">备注 {{order.remark}}</view>
  </view>
  <button class="btn btn-ghost" wx:if="{{order.canCancel}}" bind:tap="cancel">取消预约</button>
  <button class="btn btn-cta" wx:if="{{order.canArrive}}" bind:tap="arrive">我到店了</button>
  <button class="btn btn-cta" wx:if="{{order.canReorder}}" bind:tap="reorder">再来一单</button>
  <button class="btn btn-primary" open-type="contact">微信客服</button>
</view>
