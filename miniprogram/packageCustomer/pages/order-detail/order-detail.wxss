.status {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}
.status.cancelled {
  color: var(--color-muted);
  font-weight: 600;
}
.h-steps {
  display: flex;
  align-items: flex-start;
  margin-top: 28rpx;
}
.h-node {
  width: 112rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.h-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--color-line);
  box-sizing: border-box;
}
.h-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.3;
  color: var(--color-muted);
  text-align: center;
}
.h-line {
  flex: 1;
  height: 4rpx;
  margin-top: 8rpx;
  background: var(--color-line);
  border-radius: 999rpx;
}
.h-line.on {
  background: var(--color-secondary);
}
.h-node.done .h-dot {
  background: var(--color-primary);
}
.h-node.done .h-label {
  color: var(--color-primary);
  font-weight: 500;
}
.h-node.current .h-dot {
  background: var(--color-price);
  box-shadow: 0 0 0 6rpx #ffedd5;
}
.h-node.current .h-label {
  color: var(--color-price);
  font-weight: 700;
}
.item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.item + .item {
  margin-top: 10rpx;
}
.item-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}
.item-qty {
  flex-shrink: 0;
  font-size: 26rpx;
  line-height: 1.3;
  color: var(--color-muted);
  font-variant-numeric: tabular-nums;
}
.bill {
  margin-top: 20rpx;
}
.bill-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.bill-row + .bill-row {
  margin-top: 10rpx;
}
.bill-label {
  font-size: 26rpx;
  line-height: 1.4;
  color: var(--color-text);
}
.bill-money {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  color: var(--color-price);
  font-variant-numeric: tabular-nums;
}
.bill-money.off {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}
.bill-row.pay {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--color-line);
}
.bill-row.pay .bill-label {
  font-size: 28rpx;
  font-weight: 600;
}
.bill-row.pay .bill-money {
  font-size: 36rpx;
  font-weight: 700;
}
.bill-row.solo {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}
.bill-row.solo .bill-label {
  font-size: 26rpx;
  font-weight: 400;
}
.bill-row.solo .bill-money {
  font-size: 34rpx;
}
.meta {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-line);
}
.meta + .meta {
  margin-top: 10rpx;
  padding-top: 0;
  border-top: none;
}
.meta-k {
  flex-shrink: 0;
  width: 64rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--color-muted);
}
.meta-v {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
}
.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}
.actions .btn {
  width: 100%;
  margin: 0;
}
.actions .btn-ghost {
  background: var(--color-surface);
}
.actions .btn-danger {
  background: var(--color-surface);
}
