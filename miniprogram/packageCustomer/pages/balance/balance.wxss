.wave-page {
  padding: 24rpx 32rpx 48rpx;
}
.card {
  background: var(--color-surface);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-line);
}
.balance-card {
  text-align: center;
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}
.label {
  font-size: 24rpx;
  color: var(--color-muted);
}
.balance-num {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-cta);
  margin-top: 8rpx;
  line-height: 1.1;
}
.sec-title {
  font-size: 26rpx;
  font-weight: 600;
  margin: 8rpx 0;
}
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}
.row:last-child {
  border-bottom: none;
}
.row-title {
  font-size: 28rpx;
}
.sm {
  font-size: 22rpx;
  margin-top: 4rpx;
}
.delta {
  font-weight: 600;
  font-size: 28rpx;
}
.delta.plus {
  color: var(--color-cta);
}
.empty {
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
}
.grow {
  flex: 1;
  min-width: 0;
}
