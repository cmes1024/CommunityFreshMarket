<Header pageName="{{copy.titles.profile}}" back="{{false}}" />
<view class="profile-page">
  <view class="profile-head">
    <view class="avatar">{{avatarText}}</view>
    <view class="meta">
      <view class="name">{{user.nickname || copy.profile.defaultNickname}}</view>
      <view class="sub">{{user.storeMember ? copy.profile.memberHint : copy.profile.guestHint}}</view>
    </view>
  </view>

  <view class="shortcut-grid">
    <view class="shortcut" hover-class="shortcut-on" bind:tap="goOrders">
      <view class="mark"><image src="/images/profile-orders.svg" mode="aspectFit" /></view>
      <view class="shortcut-copy">
        <view class="shortcut-title">{{copy.profile.orders}}</view>
        <view class="shortcut-sub">{{copy.profile.ordersSub}}</view>
      </view>
    </view>
    <view class="shortcut" hover-class="shortcut-on" bind:tap="goAddr">
      <view class="mark mark-green"><image src="/images/profile-address.svg" mode="aspectFit" /></view>
      <view class="shortcut-copy">
        <view class="shortcut-title">{{copy.profile.addressBook}}</view>
        <view class="shortcut-sub">{{copy.profile.addressSub}}</view>
      </view>
    </view>
    <view class="shortcut" hover-class="shortcut-on" bind:tap="goPoints">
      <view class="mark mark-amber"><image src="/images/profile-points.svg" mode="aspectFit" /></view>
      <view class="shortcut-copy">
        <view class="shortcut-title">{{copy.profile.points}}</view>
        <view class="shortcut-sub">{{copy.profile.pointsSub}}</view>
      </view>
    </view>
    <view class="shortcut" hover-class="shortcut-on" bind:tap="goCoupons">
      <view class="mark"><image src="/images/profile-coupon.svg" mode="aspectFit" /></view>
      <view class="shortcut-copy">
        <view class="shortcut-title">{{copy.profile.coupons}}</view>
        <view class="shortcut-sub">{{copy.profile.couponsSub}}</view>
      </view>
    </view>
    <view class="shortcut" hover-class="shortcut-on" bind:tap="doCheckin">
      <view class="mark mark-green"><image src="/images/profile-checkin.svg" mode="aspectFit" /></view>
      <view class="shortcut-copy">
        <view class="shortcut-title">{{copy.profile.checkin}}</view>
        <view class="shortcut-sub">{{copy.profile.checkinSub}}</view>
      </view>
    </view>
    <view class="shortcut" hover-class="shortcut-on" bind:tap="openContactSheet">
      <view class="mark"><image src="/images/profile-contact.svg" mode="aspectFit" /></view>
      <view class="shortcut-copy">
        <view class="shortcut-title">{{copy.profile.contact}}</view>
        <view class="shortcut-sub">{{copy.profile.contactSub}}</view>
      </view>
    </view>
  </view>

  <view class="merchant-entry" wx:if="{{user.storeMember}}" hover-class="entry-on" bind:tap="goMerchant">
    <view class="me-title">{{copy.profile.merchantEntry}}</view>
    <view class="me-sub">{{copy.profile.merchantEntrySub}}</view>
  </view>
</view>

<page-container
  show="{{contactSheetShow}}"
  round="{{true}}"
  overlay="{{true}}"
  position="bottom"
  close-on-slide-down="{{true}}"
  custom-style="height: auto;"
  bind:clickoverlay="closeContactSheet"
  bind:afterleave="closeContactSheet"
>
  <view class="contact-sheet" catch:tap="noop">
    <view class="grab"></view>
    <view class="sheet-head">
      <view class="sheet-title">{{copy.profile.contactSheetTitle}}</view>
      <view class="sheet-close" bind:tap="closeContactSheet">关闭</view>
    </view>

    <view class="sheet-list">
      <view class="sheet-row" bind:tap="callStore">
        <view class="sheet-ico phone">
          <view class="ico-dot"></view>
        </view>
        <view class="sheet-row-main single">
          <view class="sheet-label">{{copy.profile.storePhone}}</view>
          <view class="sheet-phone {{contactPhone ? '' : 'empty'}}">
            {{contactPhone || copy.profile.storePhoneEmpty}}
          </view>
        </view>
        <view class="sheet-action">拨打</view>
      </view>

      <view class="sheet-row sheet-row-contact">
        <view class="sheet-ico chat">
          <view class="ico-dot"></view>
        </view>
        <view class="sheet-row-main single">
          <view class="sheet-label">{{copy.profile.onlineService}}</view>
          <view class="sheet-phone muted">微信会话</view>
        </view>
        <view class="sheet-action">打开</view>
        <button
          class="sheet-row-hit"
          open-type="contact"
          bind:tap="closeContactSheet"
          hover-class="none"
        ></button>
      </view>
    </view>
  </view>
</page-container>

<TabBar current="profile" />
