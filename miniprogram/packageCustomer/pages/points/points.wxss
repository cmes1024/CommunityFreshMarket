.wave-page {
  padding: 24rpx 32rpx 48rpx;
}
.card {
  background: var(--color-surface);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-line);
}
.balance-card {
  text-align: center;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}
.label-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.rate-tip {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid var(--color-muted);
  border-radius: 50%;
  color: var(--color-muted);
  font-size: 16rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}
.balance-num {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-cta);
  margin: 4rpx 0 0;
  line-height: 1.1;
}
.entry-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 8rpx;
}
.entry-link {
  flex: none;
  font-size: 26rpx;
  line-height: 1.4;
  color: var(--color-cta);
  white-space: nowrap;
}
.entry-sep {
  flex: none;
  font-size: 26rpx;
  line-height: 1.4;
  color: var(--color-line);
}
.points-sheet {
  background: var(--color-background);
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}
.points-sheet .grab {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--color-line);
  margin: 16rpx auto 8rpx;
}
.points-sheet .sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 32rpx 16rpx;
}
.points-sheet .sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}
.points-sheet .sheet-close {
  font-size: 26rpx;
  line-height: 1.3;
  color: var(--color-muted);
  padding: 8rpx 0 8rpx 24rpx;
}
.points-sheet .sheet-body {
  max-height: 56vh;
  overflow-y: auto;
  padding: 0 32rpx 8rpx;
  box-sizing: border-box;
}
.points-sheet .hint {
  margin-bottom: 8rpx;
}
.points-sheet .empty {
  padding: 80rpx 32rpx;
}
.sec-title {
  font-size: 26rpx;
  font-weight: 600;
  margin: 8rpx 0 8rpx;
}
.hint {
  font-size: 22rpx;
  margin-bottom: 16rpx;
}
.field-input {
  background: #f4f7f6;
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}
.row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}
.row:last-child {
  border-bottom: none;
}
.row-title {
  font-size: 28rpx;
}
.sm {
  font-size: 22rpx;
  margin-top: 4rpx;
}
.delta {
  font-weight: 600;
  font-size: 28rpx;
}
.delta.plus {
  color: var(--color-cta);
}
.empty {
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
}
.grow {
  flex: 1;
  min-width: 0;
}
.btn-sm {
  min-height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  padding: 0 20rpx;
  margin: 0;
}
.row {
  align-items: center;
}
