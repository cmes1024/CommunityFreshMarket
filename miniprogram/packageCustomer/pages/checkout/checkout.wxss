.steps {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}
.seg {
  display: flex;
  background: #fff;
  border-radius: var(--radius);
  overflow: hidden;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--color-line);
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 28rpx;
  font-weight: 500;
}
.seg-item.on {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}
.slot {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--color-line);
  min-height: 88rpx;
}
.slot.on {
  color: var(--color-primary);
  font-weight: 600;
}
.phrases {
  display: flex;
  flex-wrap: wrap;
  margin: 12rpx 0;
}
.area {
  width: 100%;
  min-height: 140rpx;
  margin-top: 12rpx;
  background: #f4f7f6;
  border: 1rpx solid var(--color-line);
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}
.subscribe-hint {
  margin: 8rpx 0 16rpx;
  font-size: 22rpx;
  line-height: 1.4;
}
