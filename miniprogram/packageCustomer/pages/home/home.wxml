<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackground}}" />
<Header pageName="{{displayStoreName}}" back="{{false}}" brand="{{true}}" alignContent="left" />
<view class="page-body home">
  <view class="hero {{heroImages.length ? 'has-img' : ''}}">
    <image
      wx:if="{{heroImages.length === 1}}"
      class="hero-photo"
      style="width: 100%; height: 360rpx;"
      src="{{heroImages[0]}}"
      mode="aspectFill"
    />
    <swiper
      wx:if="{{heroImages.length > 1}}"
      class="hero-swiper"
      style="width: 100%; height: 360rpx;"
      autoplay="{{true}}"
      interval="{{2500}}"
      circular="{{true}}"
      indicator-dots="{{true}}"
      indicator-color="rgba(255,255,255,0.45)"
      indicator-active-color="#ffffff"
    >
      <swiper-item wx:for="{{heroImages}}" wx:key="*this">
        <image class="hero-photo" style="width: 100%; height: 360rpx;" src="{{item}}" mode="aspectFill" />
      </swiper-item>
    </swiper>
    <view wx:if="{{heroImages.length}}" class="hero-mask"></view>
    <view class="hero-content">
      <view class="kicker">{{homeKicker}}</view>
      <view wx:if="{{homeTitle}}" class="store">{{homeTitle}}</view>
      <view class="desc">{{homeSubtitle}}</view>
    </view>
  </view>

  <view class="notice" wx:if="{{homeNotice}}">
    <text class="notice-label">公告</text>
    <view class="notice-window">
      <view class="notice-track" animation="{{noticeAnim}}">
        <view class="notice-item">
          <text class="notice-item-text">{{homeNotice}}</text>
        </view>
        <view class="notice-item">
          <text class="notice-item-text">{{homeNotice}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="status-strip">
    <view class="status-item">
      <view class="dot truck"></view>
      <view>
        <view class="strong">{{copy.home.delivery}}</view>
        <view class="muted">{{deliverySub}}</view>
      </view>
    </view>
    <view class="status-item">
      <view class="dot store"></view>
      <view>
        <view class="strong">{{copy.home.pickup}}</view>
        <view class="muted">{{pickupHint || copy.home.pickupSubFallback}}</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view class="section-title">{{copy.home.sectionWant}}</view>
      <view class="linkish" bind:tap="goAll">{{copy.home.all}}</view>
    </view>
    <scroll-view wx:if="{{products.length}}" scroll-x class="chip-scroll" enable-flex>
      <view
        class="chip-nav"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bind:tap="goCategory"
      >{{item.name}}</view>
    </scroll-view>

    <view class="home-grid cols-{{homeProductCols}}">
      <view
        class="home-card {{item.inStock ? '' : 'is-sold'}}"
        wx:for="{{products}}"
        wx:key="id"
      >
        <view class="home-card-hit" data-id="{{item.id}}" bind:tap="goDetail">
          <view class="thumb {{item.inStock ? 'veg' : 'sold'}}">
            <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" class="thumb-img" />
            <text wx:if="{{!item.inStock}}" class="sold-tag">{{copy.stock.soldOut}}</text>
          </view>
          <view class="meta">
            <view class="name">{{item.name}}</view>
            <view class="unit">{{item.unitLine}}</view>
            <view class="price">¥{{item.priceYuan}} <text class="small">/ {{item.unitLabel}}</text></view>
          </view>
        </view>
        <view wx:if="{{item.inStock}}" class="add-wrap" catch:tap="noop">
          <Stepper
            value="{{item.qty}}"
            min="{{0}}"
            max="{{item.qtyMax}}"
            step="{{item.qty > 0 ? 1 : item.qtyMinAdd}}"
            size="{{homeProductCols === 3 ? 'sm' : 'md'}}"
            bind:change="onQty"
            data-id="{{item.id}}"
            data-min="{{item.qtyMinAdd}}"
            data-max="{{item.qtyMax}}"
          />
        </view>
      </view>
    </view>

    <view wx:if="{{!products.length}}" class="empty-reco" bind:tap="goAll">
      <text>{{copy.home.emptyReco}}</text><text class="empty-reco-action">{{copy.home.emptyRecoAction}}</text>
    </view>
  </view>
</view>
<ProductSheet
  show="{{sheetShow}}"
  productId="{{sheetProductId}}"
  bind:close="onSheetClose"
  bind:changed="onSheetChanged"
/>
<TabBar current="home" />
