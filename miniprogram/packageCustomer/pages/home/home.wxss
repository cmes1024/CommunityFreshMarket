.home {
  padding-left: 0;
  padding-right: 0;
  padding-top: 0;
  position: relative;
  z-index: 0;
}
.hero {
  position: relative;
  z-index: 0;
  isolation: isolate;
  padding: 44rpx 40rpx 40rpx;
  background: var(--color-primary);
  color: var(--color-on-ink);
  min-height: 280rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.hero.has-img {
  padding: 0;
  background: var(--color-ink);
}
.hero-photo,
.hero-swiper {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 360rpx;
  display: block;
}
.hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    var(--color-hero-top, rgba(15, 61, 56, 0.28)) 0%,
    var(--color-hero-bottom, rgba(15, 61, 56, 0.55)) 100%
  );
}
.hero-content {
  position: relative;
  z-index: 2;
}
.hero.has-img .hero-content {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: 44rpx 40rpx 40rpx;
  box-sizing: border-box;
}
.kicker {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 500;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.16);
  margin-bottom: 20rpx;
}
.store {
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  letter-spacing: -1rpx;
}
.desc {
  opacity: 0.9;
  font-size: 26rpx;
  line-height: 1.55;
  max-width: 85%;
  font-weight: 300;
}
.notice {
  position: relative;
  z-index: 3;
  height: 64rpx;
  overflow: hidden;
  background: var(--color-warn-soft);
}
.notice-label {
  position: absolute;
  z-index: 1;
  left: 28rpx;
  top: 0;
  height: 64rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 64rpx;
  color: var(--color-cta);
}
.notice-window {
  position: absolute;
  left: 108rpx;
  right: 0;
  top: 0;
  height: 64rpx;
  overflow: hidden;
}
.notice-track {
  display: flex;
  flex-wrap: nowrap;
  height: 64rpx;
}
.notice-item {
  flex: none;
  height: 64rpx;
  padding-right: 80rpx;
}
.notice-item-text {
  white-space: nowrap;
  font-size: 26rpx;
  line-height: 64rpx;
  color: var(--color-text);
}
.status-strip {
  display: flex;
  background: var(--color-line);
  border-bottom: 1rpx solid var(--color-line);
}
.status-item {
  flex: 1;
  display: flex;
  gap: 20rpx;
  align-items: center;
  padding: 24rpx 28rpx;
  background: var(--color-surface);
  font-size: 24rpx;
}
.status-item + .status-item {
  margin-left: 1rpx;
}
.strong {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}
.dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.dot.truck { background: var(--color-secondary); }
.dot.store { background: var(--color-primary); }
.section {
  padding: 32rpx 32rpx 0;
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
}
.linkish {
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 500;
  padding: 16rpx 8rpx;
}
.chip-scroll {
  white-space: nowrap;
  margin-bottom: 8rpx;
  height: 72rpx;
}
.chip-nav {
  display: inline-block;
  padding: 14rpx 28rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--color-line);
  background: var(--color-surface);
  font-size: 26rpx;
  color: var(--color-muted);
}
.home-grid {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: flex-start;
  margin-top: 8rpx;
}
.home-card {
  position: relative;
  flex-grow: 0;
  flex-shrink: 0;
  margin-bottom: 20rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius);
  overflow: hidden;
  box-sizing: border-box;
}
.home-card-hit {
  display: block;
}
.thumb {
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  border-radius: 0;
  background: var(--color-ph-veg);
  position: relative;
  overflow: hidden;
}
.thumb.veg { background: var(--color-ph-veg); }
.thumb.sold { background: var(--color-ph-sold); }
.thumb-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.sold-tag {
  position: absolute;
  inset: 0;
  background: var(--color-scrim);
  color: var(--color-on-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  z-index: 1;
}
.meta {
  padding: 12rpx 12rpx 48rpx;
}
.meta .name {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.meta .unit {
  font-size: 22rpx;
  color: var(--color-muted);
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}
.price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-price);
}
.price .small {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-muted);
}
.home-card.is-sold .price {
  opacity: 0.55;
}
.add-wrap {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  z-index: 2;
  padding: 8rpx;
}

/* 1 列通栏 */
.home-grid.cols-1 .home-card {
  width: 100%;
  flex-basis: 100%;
  max-width: 100%;
  margin-right: 0;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.home-grid.cols-1 .home-card-hit {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 20rpx;
  padding: 16rpx 0 16rpx 16rpx;
}
.home-grid.cols-1 .thumb {
  width: 128rpx;
  height: 128rpx;
  padding-bottom: 0;
  flex-shrink: 0;
  border-radius: 16rpx;
}
.home-grid.cols-1 .meta {
  padding: 0;
  flex: 1;
  min-width: 0;
}
.home-grid.cols-1 .meta .name {
  -webkit-line-clamp: 1;
}
.home-grid.cols-1 .add-wrap {
  position: relative;
  right: auto;
  bottom: auto;
  flex-shrink: 0;
  padding: 0 20rpx 0 8rpx;
}

/* 2 列：不用 calc，避免 flex 子项宽度失效后被挤缩 */
.home-grid.cols-2 .home-card {
  width: 48%;
  flex-basis: 48%;
  max-width: 48%;
  margin-right: 4%;
}
.home-grid.cols-2 .home-card:nth-child(2n) {
  margin-right: 0;
}

/* 3 列 */
.home-grid.cols-3 .home-card {
  width: 32%;
  flex-basis: 32%;
  max-width: 32%;
  margin-right: 2%;
  margin-bottom: 16rpx;
}
.home-grid.cols-3 .home-card:nth-child(3n) {
  margin-right: 0;
}
.home-grid.cols-3 .meta {
  padding: 10rpx 10rpx 40rpx;
}
.home-grid.cols-3 .meta .name {
  font-size: 24rpx;
  margin-bottom: 4rpx;
}
.home-grid.cols-3 .meta .unit {
  display: none;
}
.home-grid.cols-3 .price {
  font-size: 26rpx;
}
.home-grid.cols-3 .price .small {
  font-size: 18rpx;
}
.home-grid.cols-3 .add-wrap {
  right: 4rpx;
  bottom: 4rpx;
  padding: 6rpx;
}
.home-grid.cols-3 .sold-tag {
  font-size: 20rpx;
}
.empty-reco {
  margin: 24rpx 0;
  padding: 56rpx 32rpx;
  text-align: center;
  color: var(--color-muted);
  font-size: 26rpx;
  border: 1rpx dashed var(--color-line);
  border-radius: var(--radius);
  background: rgba(255, 255, 255, 0.55);
}
.empty-reco-action {
  color: var(--color-primary);
  font-weight: 600;
}
