<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackground}}" />
<Header pageName="{{copy.titles.cart}}" back="{{false}}" />
<view class="page-body cart-page {{cart.itemCount ? 'has-bar' : ''}}">
  <view wx:if="{{!cart.itemCount}}" class="empty-state">
    <view class="empty-title">{{copy.cart.emptyTitle}}</view>
    <view class="muted">{{copy.cart.emptyHint}}</view>
    <button class="btn btn-cta" bind:tap="goCategory">{{copy.cart.goCategory}}</button>
  </view>
  <view wx:else class="cart-list">
    <view class="cart-row" wx:for="{{cart.items}}" wx:key="productId">
      <view class="thumb {{item.available ? 'veg' : 'sold'}}">
        <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" class="thumb-img" />
      </view>
      <view class="meta grow">
        <view class="name">{{item.name}}</view>
        <view class="price">
          ¥{{item.priceYuan}}<text class="hint" wx:if="{{item.priceHint}}"> / {{item.priceHint}}</text>
        </view>
        <view class="muted reason" wx:if="{{!item.available}}">{{item.unavailableReason}}</view>
      </view>
      <view class="side">
        <Stepper wx:if="{{item.available}}" value="{{item.qtyNum}}" min="{{0}}" bind:change="onQty" data-id="{{item.productId}}" />
        <view class="remove" data-id="{{item.productId}}" bind:tap="remove">{{copy.cart.remove}}</view>
      </view>
    </view>
  </view>
</view>
<view class="mini-bar" wx:if="{{cart.itemCount}}" bind:tap="checkout">
  <view>
    <text class="mini-count">{{cart.itemCount}}</text> {{copy.category.selectedSuffix}}
    <text class="price"> ¥{{cart.totalYuan}}</text>
  </view>
  <view class="go">{{copy.cart.goCheckout}}</view>
</view>
<TabBar current="cart" />
