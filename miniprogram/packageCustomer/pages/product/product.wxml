<page-meta page-style="{{themePageStyle}}" background-color="{{themeBackground}}" />
<Header pageName="{{copy.titles.product}}" back="{{true}}" />
<view class="page-body no-tab detail">
  <view class="hero {{product.inStock ? 'veg' : 'fruit'}}">
    <swiper
      wx:if="{{slides.length}}"
      class="hero-swiper"
      indicator-dots="{{slides.length > 1}}"
      indicator-color="rgba(255,255,255,0.45)"
      indicator-active-color="#ffffff"
      circular="{{slides.length > 1}}"
      autoplay="{{slideAutoplay && slides.length > 1}}"
      interval="{{3000}}"
    >
      <swiper-item wx:for="{{slides}}" wx:key="key">
        <view class="slide">
          <image wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFill" class="hero-img" />
          <view wx:if="{{item.takenText}}" class="live-time">{{item.takenText}}</view>
          <view
            wx:if="{{item.showRequest}}"
            class="live-req"
            catch:tap="requestLivePhoto"
          >{{item.requestLabel}}</view>
        </view>
      </swiper-item>
    </swiper>
  </view>
  <view class="body">
    <view class="top">
      <view class="name">{{product.name}}</view>
      <view class="chip {{product.inStock ? '' : 'sold'}}">{{product.inStock ? copy.stock.inStock : copy.stock.soldOut}}</view>
    </view>
    <view class="sub">{{product.unitLine}}</view>
    <view wx:if="{{!showcase}}" class="detail-price">¥{{product.priceYuan}} <text class="small">/ {{product.unitLabel}}</text></view>
    <view wx:if="{{showcase}}" class="info-block">
      <view class="h4">{{copy.showcase.toStore}}</view>
      <view class="p">{{copy.showcase.detailHint}}</view>
    </view>
    <view wx:if="{{!product.inStock}}" class="info-block warn">
      <view class="h4">{{copy.product.restockTitle}}</view>
      <view class="p">{{copy.product.restockBody}}</view>
    </view>
    <view wx:elif="{{contactNote}}" class="info-block">
      <view class="h4">{{copy.product.noteTitle}}</view>
      <view class="p">{{contactNote}}</view>
    </view>
  </view>
  <block wx:if="{{product.inStock}}">
    <view class="actions" wx:if="{{!showcase}}">
      <Stepper value="{{qty}}" min="{{qtyMin}}" max="{{qtyMax}}" bind:change="onStepper" />
      <button class="btn btn-cta grow-btn" bind:tap="addCart">{{copy.product.addCart}}</button>
    </view>
    <view class="actions" wx:else>
      <button wx:if="{{contactPhone}}" class="btn btn-cta grow-btn" bind:tap="callStore">{{copy.showcase.callStore}}</button>
      <view wx:else class="muted shop-hint">{{copy.showcase.noPhone}}</view>
    </view>
  </block>
  <view class="actions" wx:else>
    <button class="btn btn-primary grow-btn" bind:tap="watch">{{watching ? copy.product.watching : copy.product.watchMe}}</button>
  </view>
</view>
