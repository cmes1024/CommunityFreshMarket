.detail { padding: 0; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.hero {
  height: 420rpx;
  background: var(--color-ph-veg);
  overflow: hidden;
}
.hero.fruit { background: var(--color-ph-fruit); }
.hero-swiper {
  width: 100%;
  height: 100%;
}
.hero-img { width: 100%; height: 100%; display: block; }
.slide { position: relative; width: 100%; height: 100%; }
.live-ph {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(0, 0, 0, 0.45);
  font-size: 28rpx;
}
.live-time {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.45);
  color: var(--color-on-primary);
  font-size: 22rpx;
}
.live-req {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
}
.body { padding: 32rpx; }
.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.name { font-size: 40rpx; font-weight: 700; flex: 1; }
.chip {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  background: var(--color-mist);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
}
.chip.sold {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}
.sub { color: var(--color-muted); font-size: 24rpx; margin-bottom: 16rpx; }
.detail-price {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-price);
  margin-bottom: 28rpx;
}
.detail-price .small {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--color-muted);
}
.info-block {
  background: var(--color-surface);
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius);
  padding: 24rpx;
}
.info-block.warn {
  border-color: var(--color-warn-line);
  background: var(--color-warn-soft);
}
.h4 { font-weight: 600; margin-bottom: 8rpx; font-size: 28rpx; }
.p {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}
.actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-line);
  display: flex;
  gap: 16rpx;
  align-items: center;
  z-index: 10;
}
.grow-btn {
  flex: 1;
  margin: 0;
  min-height: 72rpx;
  font-size: 28rpx;
}
.pick-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  padding: 0 32rpx 12rpx;
  z-index: 9;
}
.pick-bar .full {
  width: 100%;
}
