<!--components/Header/index.wxml-->
<view
  class="place {{transparent ? 'is-transparent' : ''}}"
  style="height: {{headerHeightPx}}px;--header-height: {{headerHeightPx}}px;"
></view>
<view
  class="header {{transparent ? 'is-transparent' : ''}} {{brand ? 'is-brand' : ''}}"
  style="height: {{headerHeightPx}}px;top:0;{{headerStyle}};z-index:{{zIndex}}"
>
  <view
    class="header-content"
    style="width:{{menuPositionInfo.left}}px;height: {{menuPositionInfo.height}}px;margin-top:{{menuPositionInfo.top}}px"
  >
    <view wx:if="{{back}}" class="header-content-left" bind:tap="BackPage">返回</view>
    <view
      wx:elif="{{toCustomer}}"
      class="header-content-left is-customer"
      bind:tap="GoCustomer"
    >用户端</view>
    <view
      wx:if="{{!isTitleCenter}}"
      class="header-content-title text-align-{{alignContent}} {{brand ? 'is-brand' : ''}}"
      style="{{titleStyle}}"
    >{{pageName}}</view>
  </view>
  <view
    wx:if="{{isTitleCenter}}"
    class="header-title-center {{brand ? 'is-brand' : ''}}"
    style="top:{{menuPositionInfo.top}}px;height:{{menuPositionInfo.height}}px;{{titleStyle}}"
  >{{pageName}}</view>
</view>
<loading zIndex="{{zIndex+1}}"/>
<mini-use-agreement zIndex="{{zIndex+1}}" config="{{proxyConfig}}" bind:agree="agree" bind:disagree="disagree" bind:agreementClick="agreementClick" ex-panel="ex-panel" ex-wrapper="ex-wrapper" ex-logo="ex-logo" ex-btns="ex-btns" ex-disagree="ex-disagree"/>
