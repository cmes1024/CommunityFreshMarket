<!-- 数量直接用 value 渲染（步进值恒为整数），不再用 observer 算 display：
     列表里一屏几十个实例，每个都 setData 一次跨线程调用，白白拖慢列表 -->
<view class="stepper {{size === 'sm' ? 'sm' : ''}} {{value > 0 ? '' : 'compact'}}">
  <view wx:if="{{value > 0}}" class="step-btn minus {{disabled || value <= min ? 'off' : ''}}" bind:tap="onMinus">−</view>
  <text wx:if="{{value > 0}}" class="val">{{value}}</text>
  <view class="step-btn plus {{disabled || value >= max ? 'off' : ''}}" bind:tap="onPlus">+</view>
</view>
