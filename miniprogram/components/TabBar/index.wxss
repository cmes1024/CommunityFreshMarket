.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  background: #fff;
  border-top: 1rpx solid var(--color-line);
  padding-bottom: env(safe-area-inset-bottom);
  height: calc(116rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.tab {
  flex: 1;
  min-height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  position: relative;
  color: var(--color-muted);
  font-size: 20rpx;
}
.tab.active {
  color: var(--color-primary);
  font-weight: 600;
}
.ico {
  width: 44rpx;
  height: 44rpx;
}
.badge {
  position: absolute;
  top: 8rpx;
  right: 22%;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: var(--color-danger);
  color: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
}
