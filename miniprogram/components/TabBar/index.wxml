<view class="tabbar" style="border-top-color: {{themeLine}}">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tab {{item.key === activeKey ? 'active' : ''}}"
    style="color: {{item.key === activeKey ? themePrimary : themeMuted}}"
    data-url="{{item.url}}"
    data-open="{{item.open}}"
    data-key="{{item.key}}"
    bind:tap="onTap"
  >
    <image
      class="ico"
      src="{{item.key === activeKey ? (item.iconActiveSrc || item.iconActive) : (item.iconSrc || item.icon)}}"
      mode="aspectFit"
    />
    <view class="label">{{item.label}}</view>
    <view wx:if="{{item.badge > 0}}" class="badge">{{item.badge > 99 ? '99+' : item.badge}}</view>
  </view>
</view>
