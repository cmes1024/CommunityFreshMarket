.bs-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(19, 78, 74, 0.45);
  opacity: 0;
  transition: opacity 0.24s ease;
}

.bs-mask.open {
  opacity: 1;
}

.bs-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 88vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  transform: translateY(100%);
  transition: transform 0.26s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.bs-panel.open {
  transform: translateY(0);
}
