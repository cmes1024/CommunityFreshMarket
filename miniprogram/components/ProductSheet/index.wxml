<page-container
  show="{{show}}"
  round="{{true}}"
  overlay="{{true}}"
  position="bottom"
  close-on-slide-down="{{true}}"
  custom-style="height: 78%;"
  bind:clickoverlay="close"
  bind:afterleave="onAfterLeave"
>
  <view class="sheet" catch:tap="noop">
    <view class="grab"></view>
    <view wx:if="{{loading}}" class="loading">加载中…</view>
    <block wx:elif="{{product}}">
      <scroll-view scroll-y class="sheet-body">
        <view class="hero {{product.inStock ? 'veg' : 'fruit'}}">
          <swiper
            wx:if="{{slides.length}}"
            class="hero-swiper"
            indicator-dots="{{slides.length > 1}}"
            indicator-color="rgba(255,255,255,0.45)"
            indicator-active-color="#ffffff"
            circular="{{slides.length > 1}}"
            autoplay="{{slides.length > 1}}"
            interval="{{3000}}"
          >
            <swiper-item wx:for="{{slides}}" wx:key="key">
              <view class="slide">
                <image wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFill" class="hero-img" />
                <view wx:else class="live-ph">{{copy.livePhoto.placeholder}}</view>
                <view wx:if="{{item.takenText}}" class="live-time">{{item.takenText}}</view>
                <view
                  wx:if="{{item.showRequest}}"
                  class="live-req"
                  catch:tap="requestLivePhoto"
                >{{item.requestLabel}}</view>
              </view>
            </swiper-item>
          </swiper>
        </view>
        <view class="info">
          <view class="top">
            <view class="name">{{product.name}}</view>
            <view class="chip {{product.inStock ? '' : 'sold'}}">
              {{product.inStock ? copy.stock.inStock : copy.stock.soldOut}}
            </view>
          </view>
          <view class="sub">{{product.unitLine}}</view>
          <view class="price">
            ¥{{product.priceYuan}}
            <text class="small">/ {{product.unitLabel}}</text>
          </view>
          <view wx:if="{{!product.inStock}}" class="info-block warn">
            <view class="h4">{{copy.product.restockTitle}}</view>
            <view class="p">{{copy.product.restockBody}}</view>
          </view>
          <view wx:elif="{{contactNote}}" class="info-block">
            <view class="h4">{{copy.product.noteTitle}}</view>
            <view class="p">{{contactNote}}</view>
          </view>
        </view>
      </scroll-view>
      <view class="actions" wx:if="{{product.inStock}}">
        <Stepper value="{{qty}}" min="{{qtyMin}}" max="{{qtyMax}}" bind:change="onStepper" />
        <button class="cta" bind:tap="addCart">{{copy.product.addCart}}</button>
      </view>
      <view class="actions" wx:else>
        <button class="cta primary" bind:tap="watch">
          {{watching ? copy.product.watching : copy.product.watchMe}}
        </button>
      </view>
    </block>
  </view>
</page-container>
