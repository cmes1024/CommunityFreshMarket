.sheet {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--color-background, #f0fdfa);
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  box-sizing: border-box;
}

.grab {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--color-line, #cce5e1);
  margin: 16rpx auto 8rpx;
  flex-shrink: 0;
}

.loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-muted, #5b7c78);
  font-size: 26rpx;
}

.sheet-body {
  flex: 1;
  height: 0;
  padding-bottom: 24rpx;
  box-sizing: border-box;
}

.hero {
  height: 360rpx;
  background: var(--color-ph-veg);
  overflow: hidden;
  margin: 0 24rpx;
  border-radius: 20rpx;
}
.hero.fruit {
  background: var(--color-ph-fruit);
}
.hero-swiper {
  width: 100%;
  height: 100%;
}
.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}
.slide { position: relative; width: 100%; height: 100%; }
.live-ph {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(0, 0, 0, 0.45);
  font-size: 28rpx;
}
.live-time {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.45);
  color: var(--color-on-primary);
  font-size: 22rpx;
}
.live-req {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.info {
  padding: 28rpx 32rpx 16rpx;
}

.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text, #134e4a);
  flex: 1;
  min-width: 0;
}

.chip {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-mist);
  color: var(--color-primary, #0f766e);
  font-size: 22rpx;
  font-weight: 600;
}
.chip.sold {
  background: var(--color-danger-soft);
  color: var(--color-danger, #dc2626);
}

.sub {
  color: var(--color-muted, #5b7c78);
  font-size: 24rpx;
  margin-bottom: 14rpx;
}

.price {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-price, #d97706);
  margin-bottom: 24rpx;
}
.price .small {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--color-muted, #5b7c78);
}

.info-block {
  background: var(--color-surface);
  border: 1rpx solid var(--color-line, #cce5e1);
  border-radius: 20rpx;
  padding: 24rpx;
}
.info-block.warn {
  border-color: var(--color-warn-line);
  background: var(--color-warn-soft);
}
.h4 {
  font-weight: 600;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  color: var(--color-text, #134e4a);
}
.p {
  color: var(--color-muted, #5b7c78);
  font-size: 24rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}

.pick-row {
  flex-shrink: 0;
  padding: 8rpx 28rpx 0;
}

.btn-pick {
  margin: 0;
  width: 100%;
  min-height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  background: var(--color-mist, #ccfbf1);
  color: var(--color-primary, #0f766e);
  border-radius: 16rpx;
  border: none;
}
.btn-pick::after {
  border: none;
}

.actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-line, #cce5e1);
}

.cta {
  flex: 1;
  margin: 0;
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: var(--color-cta, #0f766e);
  color: var(--color-on-primary);
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}
.cta::after {
  border: none;
}
.cta.primary {
  background: var(--color-primary, #0f766e);
}
