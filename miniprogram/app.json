{
  "pages": [
    "pages/launch/launch",
    "pages/home/home",
    "pages/category/category",
    "pages/cart/cart",
    "pages/profile/profile"
  ],
  "subPackages": [
    {
      "root": "packageCustomer",
      "name": "customer",
      "pages": [
        "pages/product/product",
        "pages/checkout/checkout",
        "pages/address-list/address-list",
        "pages/address-edit/address-edit",
        "pages/orders/orders",
        "pages/order-detail/order-detail",
        "pages/join-store/join-store",
        "pages/points/points",
        "pages/balance/balance",
        "pages/member-code/member-code",
        "pages/coupons/coupons"
      ]
    },
    {
      "root": "packageMerchant",
      "name": "merchant",
      "pages": [
        "pages/orders/orders",
        "pages/order-detail/order-detail",
        "pages/products/products",
        "pages/product-edit/product-edit",
        "pages/categories/categories",
        "pages/settings/settings",
        "pages/profile/profile",
        "pages/live-photos/live-photos",
        "pages/point-counter/point-counter",
        "pages/balance-topup/balance-topup",
        "pages/coupons/coupons",
        "pages/point-redeems/point-redeems"
      ]
    }
  ],
  "tabBar": {
    "custom": true,
    "color": "#5B7C78",
    "selectedColor": "#0F766E",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      { "pagePath": "pages/home/home", "text": "首页" },
      { "pagePath": "pages/category/category", "text": "分类" },
      { "pagePath": "pages/cart/cart", "text": "商品篮" },
      { "pagePath": "pages/profile/profile", "text": "我的" }
    ]
  },
  "preloadRule": {
    "pages/launch/launch": {
      "network": "all",
      "packages": ["customer", "merchant"]
    },
    "pages/home/home": {
      "network": "all",
      "packages": ["customer", "merchant"]
    }
  },
  "window": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "绿意鲜生",
    "navigationBarBackgroundColor": "#F0FDFA",
    "navigationStyle": "custom",
    "backgroundColor": "#F0FDFA",
    "backgroundColorTop": "#F0FDFA",
    "backgroundColorBottom": "#F0FDFA"
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
