page {
  --safe-area-bottom: 64rpx;

  /* 模板遗留变量名，全部指向上面的品牌色板，不再单独用蓝 / 粉 / 紫 / 微信绿 */
  --proxy-color: var(--color-primary);
  --theme-color: var(--color-primary);
  --active-btn-color: var(--color-primary);
  --main-color: var(--color-primary);
  --second-color: var(--color-muted);
  --main-opacity-color: rgba(15, 118, 110, 0.09);
  --promotion-main-color: var(--color-primary);
  --promotion-second-color: var(--color-secondary);
  --promotion-third-color: var(--color-price);
  --login-bg-color: var(--color-primary);

  --color-333: var(--color-text);
  --color-666: var(--color-muted);
  --color-999: var(--color-muted);
  --color-ccc: var(--color-line);

  --saleout-txt-color: var(--color-danger);
  --info-color: var(--color-primary);
  --success-color: var(--color-primary);
  --warning-color: var(--color-warn);
  --error-color: var(--color-danger);
}
