# MinIO 官方镜像已不能从 Docker Hub 公开拉取，从官方 CDN 下二进制自己打包。
#
# 下载慢或不通时，用 compose 的 build.args 覆盖：
#   MINIO_DOWNLOAD_BASE  指向镜像站目录，文件名须保持 minio.<RELEASE> 的形式
#   BASE_IMAGE           指到国内 alpine 镜像
ARG BASE_IMAGE=alpine:3.20
FROM ${BASE_IMAGE}

ARG MINIO_RELEASE=RELEASE.2025-09-07T16-13-09Z
# dl.min.io 比 GitHub releases 稳定；GitHub 的命名是 minio.linux-amd64.<RELEASE>，不通用。
ARG MINIO_DOWNLOAD_BASE=https://dl.min.io/server/minio/release/linux-amd64/archive

RUN apk add --no-cache ca-certificates curl \
  && curl -fsSL --retry 3 --retry-delay 2 -o /usr/bin/minio \
    "${MINIO_DOWNLOAD_BASE}/minio.${MINIO_RELEASE}" \
  && chmod +x /usr/bin/minio \
  && adduser -D -u 1000 minio \
  && mkdir -p /data \
  && chown -R minio:minio /data

USER minio
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
