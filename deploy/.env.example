# Copy to deploy/.env and adjust before production use.
# 数据库和 MinIO 由本项目的 Compose 自己拉起，账号写在 docker-compose.yml，不写在这里。

DB_PASSWORD=cfm_dev_password

WX_APPID=
WX_SECRET=

# 容器访问微信。本机若开了系统代理（常见 127.0.0.1:7890），容器直连 api.weixin.qq.com
# 会在 TLS 握手处挂住，POST /api/v1/auth/wechat 一直无响应。填宿主机代理后走代理。
# Colima / Docker Desktop 用 host.docker.internal。不走代理就留空。
# HTTPS_PROXY=http://host.docker.internal:7890

DEFAULT_STORE_ID=1
# 店主微信 openid：该账号登录后自动成为默认店 OWNER（本地/生产同一机制）
# 可先正常登录一次，再查库：SELECT id, openid, nickname FROM "user";
BOOTSTRAP_OWNER_OPENID=

# 手机打开图片的前缀，末尾不要斜杠。与 MinIO 桶名相同。
# 正式：https://cfm.zfqwjs.com/communityfreshmarket
# 宝塔反向代理目录 /communityfreshmarket，目标 http://127.0.0.1:9002
# 开发者工具：http://127.0.0.1:9002/communityfreshmarket
UPLOAD_PUBLIC_BASE=https://cfm.zfqwjs.com/communityfreshmarket

# ---------- 微信订阅消息模板 ID（公众平台 → 订阅消息；未填则服务端只打日志、不阻断业务）----------
# 硬约束：只能推给「已在小程序里点过授权」的 openid；无法向未订阅的店员/顾客推送。
# 授权必须由用户点击触发（下单按钮 / 「开启订单通知」/ 「到货提醒我」等），onShow 弹框不可靠。
# 小程序 config.js 同名驼峰字段须与下列值一致。
# 新预约 / 取消 / 配送出发：thing1=摘要，thing2=提示语。
# 到货提醒：thing1=商品名，thing2=门店名，thing3=提示语。关键词顺序须一致。
#
# 到货提醒：顾客点「到货提醒我」授权；改回有货 → 发该顾客。
WX_SUBSCRIBE_RESTOCK_TEMPLATE_ID=
# 新预约单：店员在订单台点「开启订单通知」授权；顾客下单 → 仅发给已授权的店员。
WX_SUBSCRIBE_NEW_ORDER_TEMPLATE_ID=
# 订单取消：店员点「开启订单通知」授权；顾客取消 → 仅发给已授权的店员。店员取消不推给顾客。
WX_SUBSCRIBE_CANCEL_TEMPLATE_ID=
# 配送出发：顾客提交上门配送时授权；店员把单推进「配送中」→ 发给该顾客。自提不申请这条。
WX_SUBSCRIBE_DELIVERING_TEMPLATE_ID=

# ---------- 邀请店员：普通链接二维码（非太阳码）----------
# 链接形态：{INVITE_LINK_BASE}?code={邀请码}
# 公众平台 → 扫普通链接二维码打开小程序，配置前缀匹配 INVITE_LINK_BASE
# 小程序落地页：packageCustomer/pages/join-store/join-store
# 页面参数名：code（邀请码）
INVITE_LINK_BASE=https://cfm.zfqwjs.com/cfm/join

# 登录会话默认 7 天（604800 秒），一般不用写。
# SESSION_EXPIRE_SECONDS=604800

HTTP_PORT=8088
# 宿主机 9000 已被占用，本项目 MinIO 只绑回环 9002。
MINIO_API_PORT=9002
